<body class="d-flex align-items-center min-h-100">

    <script src="~/assets/js/hs.theme-appearance.js"></script>

    <!-- ========== HEADER ========== -->
    <header class="position-absolute top-0 start-0 end-0 mt-3 mx-3">
        <div class="d-flex d-lg-none justify-content-between">
            <a href="index.html">
                <img class="w-100" src="~/assets/marketplace/image/logo.png" alt="Image Description" data-hs-theme-appearance="default" style="min-width: 7rem; max-width: 7rem;">
                <img class="w-100" src="~/assets/marketplace/image/logo.png" alt="Image Description" data-hs-theme-appearance="dark" style="min-width: 7rem; max-width: 7rem;">
            </a>
        </div>
    </header>

    <main id="content" role="main" class="main">
        <div class="position-fixed top-0 end-0 start-0 bg-img-start" style="height: 32rem; background-image: url(../../assets/svg/components/card-6.svg);">
            <!-- Shape -->
            <div class="shape shape-bottom zi-1">
                <svg preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" viewBox="0 0 1921 273">
                    <polygon fill="#fff" points="0,273 1921,273 1921,0 " />
                </svg>
            </div>
            <!-- End Shape -->
        </div>

        <!-- Content -->
        <div class="container py-5 py-sm-7">
            <a class="d-flex justify-content-center mb-5" href="index.html">
                <img class="zi-2" src="~/assets/marketplace/image/logo.png" alt="Image Description">
            </a>

            <div class="mx-auto" style="max-width: 30rem;">
                <!-- Card -->
                <div class="card card-lg mb-5">
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <img class="avatar avatar-xxl avatar-4x3" src="../../assets/svg/illustrations/oc-email-verification.svg" alt="Image Description" data-hs-theme-appearance="default">
                            <img class="avatar avatar-xxl avatar-4x3" src="../../assets/svg/illustrations-light/oc-email-verification.svg" alt="Image Description" data-hs-theme-appearance="dark">
                        </div>

                        <h1 class="display-5">Verify your mobile no</h1>

                        @if (@TempData["MobileVerificationErroMessage"] != null)
                        {
                            <div class="alert" role="alert" style="color:red;">
                                @TempData["MobileVerificationErroMessage"]
                            </div>
                        }

                        @if (@TempData["MobileVerificationSuccessMessage"] != null)
                        {
                            <div class="alert" role="alert" style="color: #00c9a7;">
                                @TempData["MobileVerificationSuccessMessage"]
                            </div>
                        }
                        

                        <form class="otp-form" method="post" action="/Account/MobileVerification">
                            @Html.AntiForgeryToken()
                            <div class="flex flex-col space-y-6">
                                <div class="flex flex-row items-center justify-between mx-auto w-full max-w-sm">
                                    <input type="text" class="otp-input w-14 h-14">
                                    <input type="text" class="otp-input w-14 h-14">
                                    <input type="text" class="otp-input w-14 h-14">
                                    <input type="text" class="otp-input w-14 h-14">
                                    <input type="text" class="otp-input w-14 h-14">
                                    <input type="text" class="otp-input w-14 h-14">
                                </div>
                                <div class="flex justify-center">

                                    <div>Time left = <span id="timer"></span></div>

                                    @Html.ValidationMessageFor(model => model.OTP, "", new { @class = "invalid-feedback-2" })

                                    <input type="hidden" class="text-center px-5 outline-none rounded-lg border border-gray-300 text-lg bg-white focus:bg-gray-50 focus:ring-1 ring-blue-700 h-12 w-4/5" id="OTP" name="OTP" readonly="">
                                </div>
                                <div class="flex items-center flex-col space-y-5">

                                    <button type="submit" id="Btn_VarifyOtp" class="flex px-5 text-center border rounded-xl outline-none py-4 bg-blue-700 hover:bg-blue-800 border-none text-white text-md" style="color: #fff !important; background-color: #3fbfc7; border-color: #3fbfc7 !important; width: 100%; border-radius: 40px; padding: 13px 155px !important; outline: none;">
                                        Verify OTP
                                    </button>

                                </div>
                            </div>
                        </form>

                        <form class="otp-form" method="post" action="/Account/ResendVerificationOTP">
                            @Html.AntiForgeryToken()
                            <button type="submit" id="Btn_ResendOtp" onclick="ReendOtp()" class="flex px-5 text-center border rounded-xl outline-none py-4 bg-blue-700 hover:bg-blue-800 border-none text-white text-md" style="color: #fff !important; background-color: #3fbfc7; border-color: #3fbfc7 !important; width: 100%; border-radius: 40px; padding: 13px 155px !important; outline: none;">
                                Resend Otp
                            </button>
                        </form>

                    </div>
                </div>

            </div>
        </div>
        <!-- End Content -->
    </main>

    <script src="~/assets/js/vendor.min.js"></script>

    <!-- JS Front -->
    <script src="~/assets/js/theme.min.js"></script>
    <script src="~/assets/js/Otpvarification.js"></script>
    <!-- JS Plugins Init. -->


    
</body>
</html>
