@model Barrway.DTO.BusinessModels.BusinessCompanyViewModel

<input id="hiddenInputPaletteId" value="@Model.PALETTE_ID" readonly style="display:none;" />
<input id="hiddenInputTemplateId" value="@Model.TEMPLATE_ID" readonly style="display:none;" />

<style>

    .p-6p {
        padding: 6px;
    }

    .selection-header {
        display: flex;
        width: 100%;
        justify-content: space-between;
    }

        .selection-header .action-btns {
            margin-top: 0px;
        }

            .selection-header .action-btns .btn {
                margin-left: 4px;
                margin-right: 4px;
                margin-top: 0px;
            }

        .selection-header .title {
            font-size: 24px;
            font-weight: 600;
            color: black;
        }

    .palette-selection {
        margin-top: 3.5rem;
    }

        .palette-selection .title {
            color: black;
            font-size: 16px;
            font-weight: 600;
        }

    .palette-area {
        display: flex;
        justify-content: flex-start;
    }

        .palette-area .palette {
            margin-right: 16px;
            display: flex;
            justify-content: space-evenly;
            align-items: center;
            border: 1px solid grey;
            border-radius: 6px;
            margin-top: 16px;
        }

            .palette-area .palette.active {
                border: 3px solid #72328A;
            }

            .palette-area .palette .palette-item {
                background: red;
                height: 26px;
                width: 26px;
                margin-right: 6px;
                border-radius: 4px;
            }


                .palette-area .palette .palette-item:last-child {
                    margin-right: 0px;
                }

            .palette-area .palette .template-item {
                min-height: 300px;
                min-width: 300px;
                height: 100%;
                width: 100%;
                border-radius: 4px;
            }


    @@media screen and (max-width: 800px) {
        .selection-header {
            display: block;
            width: 100%;
            justify-content: space-between;
        }

            .selection-header .action-btns {
                margin-top: 8px;
            }

                .selection-header .action-btns .btn {
                    margin-left: 0px;
                    margin-right: 8px;
                    margin-top: 8px;
                }

        .palette-area {
            display: block;
            justify-content: flex-start;
        }

            .palette-area .palette {
                width: fit-content;
            }
    }
</style>

<section class="container">

    <div class="selection-header">
        <div class="title">
            Design your website
        </div>
        <div class="action-btns">
            <button class="btn btn-primary" onclick="submitTemplate()">Apply</button>
            <button class="btn btn-danger" onclick="submitTemplate()">Publish</button>
        </div>
    </div>
    <div class="palette-selection">
        <div class="title">
            Select a color palette
        </div>
        <div class="palette-area" id="color-palettes">
        </div>
    </div>

    <div class="palette-selection">
        <div class="title">
            Select a template for your website
        </div>
        <div class="palette-area" id="site-templates">
            <label for="t1" data-template-id="t1">
                <input type="radio" name="site-template" checked style="display:none;" id="t1" value="t1" />
                <div class="palette active">
                    <img class="template-item" src="~/assets/img/WebsiteTemplates/Template1.png" />
                </div>
            </label>
            <label for="t2" data-template-id="t2">
                <input type="radio" name="site-template" style="display:none;" id="t2" value="t2" />
                <div class="palette">
                    <img class="template-item" src="~/assets/img/WebsiteTemplates/Template2.png" />
                </div>
            </label>
            <label for="t3" data-template-id="t3">
                <input type="radio" name="site-template" style="display:none;" id="t3" value="t3" />
                <div class="palette">
                    <img class="template-item" src="~/assets/img/WebsiteTemplates/Template3.png" />
                </div>
            </label>

        </div>
    </div>

</section>