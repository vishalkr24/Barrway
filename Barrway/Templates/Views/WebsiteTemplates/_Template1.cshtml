@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel

<!-- heading -->
<section class="heading templet-one">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="templet-one-head">
                    <h2>@(string.IsNullOrEmpty(Model.COMPANY_NAME_ENGLISH)? "Company Name" : Model.COMPANY_NAME_ENGLISH) (@Model.COMPANY_NAME_CHINESE)</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="company-detail-main">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="main-banner">
                    <div class="main-banner-inner">
                        <div class="main-banner-inner-content">                            
                            <button class="banner-button">Book Now</button>
                        </div>
                    </div>
                </div>
               @* <div class="cd-banner">
                    <img onerror="this.src='../assets/marketplace/image/marketplace-detail.jpg'" src="@Model.COMPANY_BANNER_PATH.Replace("~", "..")" style="width: 100%; max-height:300px;">
                </div>*@
            </div>
        </div>
        <div class="row mt-30">
            <div class="col-md-3">
                <div class="address">
                    <div class="add-phone">
                        <p class="pink"><b>@Resource.Phone</b></p>
                        <p>@(string.IsNullOrEmpty(Model.COMPANY_PHONE)? "--": Model.COMPANY_PHONE)</p>
                    </div>
                    <div class="add-email">
                        <p class="pink"><b>@Resource.Email</b></p>
                        <p>@(string.IsNullOrEmpty(Model.COMPANY_EMAIL)? "--": Model.COMPANY_EMAIL)</p>
                    </div>
                    <div class="add-social">
                        <p>
                            <a href="@(string.IsNullOrEmpty(Model.WECHAT_URL)? "#": Model.WECHAT_URL)"><img src="~/assets/marketplace/image/whatsapp.png"></a>
                            <a href="@(string.IsNullOrEmpty(Model.INSTAGRAM_URL)? "#": Model.INSTAGRAM_URL)"><img src="~/assets/marketplace/image/insta.png"></a>
                            <a href="@(string.IsNullOrEmpty(Model.FACEBOOK_URL)? "#": Model.FACEBOOK_URL)"><img src="~/assets/marketplace/image/facebook.png"></a>
                            <a href="@(string.IsNullOrEmpty(Model.WECHAT_URL)? "#": Model.WECHAT_URL)"><img src="~/assets/marketplace/image/chat.png"></a>
                        </p>
                    </div>
                    <div class="chat-button">
                        <button><img src="~/assets/marketplace/image/cahe-button.png" /><span>Chat</span></button>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-6">
                        <div class="detail">
                            <p class="pink"><b>@Resource.Company_category</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_CATEGORY_NAME) ? "Category not mentioned": Model.COMPANY_CATEGORY_NAME)</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="detail">
                            <p class="pink"><b>@Resource.Company_sub_category</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_SUB_CATEGORY_NAME) ? "Sub-Category not mentioned": Model.COMPANY_SUB_CATEGORY_NAME)</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="detail">
                            <p class="pink"><b>@Resource.Address</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_ADDRESS) ? "Address not mentioned": Model.COMPANY_ADDRESS)</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="detail">
                            <p class="pink"><b>@Resource.Country</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_COUNTRY_NAME) ? "Country not mentioned": Model.COMPANY_COUNTRY_NAME)</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail">
                            <p class="pink"><b>@Resource.City</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_CITY_NAME) ? "City not mentioned": Model.COMPANY_CITY_NAME)</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="detail">
                            <p class="pink"><b>@Resource.District</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_DISTRICT_NAME) ? "District not mentioned": Model.COMPANY_DISTRICT_NAME)</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="detail">
                            <p class="pink"><b>@Resource.Company_description (200 @Resource.words)</b></p>
                            <p>@(string.IsNullOrEmpty(Model.COMPANY_DESCRIPTION)? "Discription not mentioned": Model.COMPANY_DESCRIPTION)</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="detail">
                            <p class="pink"><b>Tag 1</b></p>
                            <p>
                                @if (!string.IsNullOrEmpty(Model.TAGS))
                                {
                                var tags = Model.TAGS.Split(',');
                                foreach (var item in tags)
                                {
                                <a href="/Marketplace/Tag?tag=@item.Trim()">@item,</a>
                                }
                                }

                            </p>
                        </div>                        
                        

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

