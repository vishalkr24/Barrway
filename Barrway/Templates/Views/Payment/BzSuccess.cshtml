
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Resource.Payment_Successfull</title>
    <link rel="stylesheet" href="/assets/css/vendor.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/assets/marketplace/css/style.css">
    <link rel="stylesheet" href="~/assets/marketplace/owl/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/marketplace/owl/owl.theme.default.min.css">

    <link rel="stylesheet" type="text/css" href="~/assets/marketplace/css/media.css">
    <script src="~/assets/marketplace/owl/jquery.min.js"></script>
</head>
<body>
    <input value="@ViewBag.PaymentId" readonly style="display:none;" id="read-payment-id" />
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script>
        $(document).ready(function () {
            swal({
                icon: "success",
                title: "@Resource.Payment_Successfull !",
                text: "@Resource.Your_payment_was_successfull__This_is_your_Payment_Id :- " + $("#read-payment-id").val() + "",
                buttons: {
                    confirm: "@Resource.Go_to_dashboard"
                }
            }).then(function () {
                window.location.href = "/BusinessAdmin/Dashboard";
            })
        });
    </script>
</body>
</html>
