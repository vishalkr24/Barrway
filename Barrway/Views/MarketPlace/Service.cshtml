@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel
@{
    ViewBag.Title = Resource.Company_Service;
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
    ViewBag.COMPANY_LOGO_PATH = Model.COMPANY_LOGO_PATH.Replace("~", "");
    //ViewBag.COMPANY_ID = Model.COMPANY_CODE.ToString();
    ViewBag.COMPANY_ID = Model.PAGE_URL.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
    ViewBag.COMPANY_CODE = Model.COMPANY_CODE;
}
<input id="txtCurrentCompanyCode" value="@ViewBag.COMPANY_CODE" readonly style="display:none;" />
<style>
    .swal-footer {
        text-align: center;
    }

    #full-stars-example .rating-group {
        display: inline-flex;
    }

    #full-stars-example .rating__icon {
        pointer-events: none;
    }

    #full-stars-example .rating__input {
        position: absolute !important;
        left: -9999px !important;
    }

    #full-stars-example .rating__label {
        cursor: pointer;
        padding: 0 0.1em;
        font-size: 2rem;
    }

    #full-stars-example .rating__icon--star {
        color: orange;
    }

    #full-stars-example .rating__icon--none {
        color: #bbb8b8;
    }

    #full-stars-example .rating__input--none:checked + .rating__label .rating__icon--none {
        color: red;
    }

    #full-stars-example .rating__input:checked ~ .rating__label .rating__icon--star {
        color: #ddd;
    }

