@section scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-daterangepicker/3.0.5/daterangepicker.min.js" integrity="sha512-mh+AjlD3nxImTUGisMpHXW03gE6F4WdQyvuFRkjecwuWLwD2yCijw4tKA3NsEFpA1C3neiKhGXPSIGSfCYPMlQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-daterangepicker/3.0.5/daterangepicker.css" integrity="sha512-gp+RQIipEa1X7Sq1vYXnuOW96C4704yI1n0YB9T/KqdvqaEgL6nAuTSrKufUX3VBONq/TPuKiXGLVgBKicZ0KA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
    <script src="~/Scripts/MarketplaceScripts/marcket-palce--dropdwn-calendar.js"></script>
    <script src="~/Scripts/MarketplaceScripts/CompanyScheduleYear.js?@DateTimeUtility.Now().ToString("yyyyMmddHHMMssffff")"></script>

    <script>

        FormGeneratorApp.controller('myCtrl', function ($scope, $rootScope) {
            $scope.rootScopeSafe = function () {
                $rootScope.safeApply();
            };

            $(document).on("click", ".navigation-element", function () {
                $(".navigation-element").removeClass("btn-primary");
                $(this).addClass("btn-primary");
            })

            angular.element($("#dateRangePickerModel")).scope().selectedLocationName = "";
            angular.element($("#dateRangePickerModel")).scope().selectedStartDate = "DD-MM-YYYY";
            angular.element($("#dateRangePickerModel")).scope().selectedEndDate = "DD-MM-YYYY";

            $rootScope.safeApply = function (fn) {
                var phase = this.$root.$$phase;
                if (phase == '$apply' || phase == '$digest') {
                    if (fn && (typeof (fn) === 'function')) {
                        fn();
                    }
                } else {
                    this.$apply(fn);
                }
            };

            $scope.enrollPublicUserForRental = function () {

                showLoader();
                $.ajax({
                    url: "/Account/CheckPublicUserLogin",
                    type: "POST",
                    success: function (response) {
                        hideLoader();
                        if (!response.Status) {

                            swal({
                                title: "Login Required",
                                text: "Kindly login into your account and then you can enroll yourself into this calendar.",
                                icon: "info",
                                buttons: {
                                    confirm: "Login",
                                    cancel: "Leave it"
                                }
                            }).then(function (value) {
                                if (value) {
                                    window.location.href = '/Account/BusinessLogin?returnUrl=' + window.location.href + '';
                                }
                            });
                        } else {
                            showLoader();

                            let eventData = $scope.selectEventDetails;

                            var obj = {
                                start: eventData.start,
                                end: eventData.end,
                                resources: eventData.resources,
                                activities: "",
                                description: "",
                                allDay: "false",
                                color: "",
                                CALENDAR_CODE: eventData.CALENDAR_CODE,
                                COMPANY_CODE: eventData.COMPANY_CODE
                            }

                            $.ajax({
                                url: "/UserAdmin/CreateRoomBookingSlot",
                                type: "POST",
                                data: obj,
                                success: function (data) {
                                    hideLoader();
                                    if (!data.Status) {
                                        swal({
                                            title: "Failed to book",
                                            text: data.Message,
                                            icon: "error",
                                            button: "Okay"
                                        });
                                    } else {
                                        swal({
                                            title: "Congratulations!",
                                            text: data.Message,
                                            icon: "success",
                                            button: "Okay"
                                        }).then(function (boolValue) {
                                            window.location.reload();
                                        });

                                    }

                                },
                                error: function () {
                                    swal({ type: 'error', showCloseButton: true, html: "something went wrong!" });
                                }
                            })
                        }

                    },
                    error: function () {

                    }
                })


            }

        });


        function markAsFavorite(CompanyCode) {

            var CalendarCode = $(".calendar-selector option:selected").val();

            $.ajax({
                url: "/Account/CheckPublicUserLogin",
                type: "POST",
                success: function (response) {

                    if (!response.Status) {

                        swal({
                            title: "Login Required",
                            text: "Kindly login into your account and then you can mark calendar as favorite.",
                            icon: "info",
                            buttons: {
                                confirm: "Login",
                                cancel: "Leave it"
                            }
                        }).then(function (value) {
                            if (value) {
                                window.location.href = '/Account/BusinessLogin?returnUrl=' + window.location.href + '';
                            }
                        });

                    } else {

                        $.ajax({

                            url: "/UserAdmin/AddFavoriteCalendar",
                            type: "POST",
                            data: {
                                CALENDAR_CODE: CalendarCode,
                                COMPANY_CODE: CompanyCode
                            },
                            success: function (response) {
                                if (response.Status) {
                                    $("#btn-mark").remove();
                                    swal({
                                        title: "Marked Successfully!",
                                        text: "Calendar marked as favorite!",
                                        icon: "success",
                                        button: "Okay"
                                    }).then(function (boolValue) {
                                        window.location.reload();
                                    });


                                } else {
                                    swal({
                                        title: "Mark Failed!",
                                        text: "Failed to mark calendar as favorite!",
                                        icon: "error",
                                        button: "Okay"
                                    });
                                }

                            }

                        })

                    }


                }
            });

        }

        function removeAsFavorite(CompanyCode) {

            var CalendarCode = $(".calendar-selector option:selected").val();

            $.ajax({
                url: "/Account/CheckPublicUserLogin",
                type: "POST",
                success: function (response) {

                    if (!response.Status) {
                        swal({
                            title: "Login Required",
                            text: "Kindly login into your account and then you can Unmark calendar as favorite.",
                            icon: "info",
                            buttons: {
                                confirm: "Login",
                                cancel: "Leave it"
                            }
                        }).then(function (value) {
                            if (value) {
                                window.location.href = '/Account/BusinessLogin?returnUrl=' + window.location.href + '';
                            }
                        });
                    } else {

                        $.ajax({

                            url: "/UserAdmin/RemoveFavoriteCalendar",
                            type: "POST",
                            data: {
                                CALENDAR_CODE: CalendarCode,
                                COMPANY_CODE: CompanyCode
                            },
                            success: function (response) {
                                if (response.Status) {
                                    $("#btn-unmark").remove();
                                    swal({
                                        title: "Unmarked Successfully!",
                                        text: "Calendar removed from favorites!",
                                        icon: "success",
                                        button: "Okay"
                                    }).then(function (boolValue) {
                                        window.location.reload();
                                    });


                                } else {
                                    swal({
                                        title: "Unmark Failed!",
                                        text: "Failed to Unmark calendar as favorite!",
                                        icon: "error",
                                        button: "Okay"
                                    });
                                }



                            }

                        })

                    }


                }
            });

        }

    </script>

}