<!-- booking -->
<section class="bookinng mt-80">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="booking-text">
                    <h2>@Resource.One_stop_event_sharing_booking_platform</h2>
                    <p>Barrway is a comprehensive SaaS platform designed to simplify your booking experience. Whether you're looking to attend a workshop, make a clinic appointment, reserve a beauty treatment, dine at top restaurants, book a co-working space, or organize a party, Barrway has you covered. Our platform manages bookings and payments efficiently, ensuring a seamless interaction with your favorite local businesses.</p>    
                </div>
            </div>
            <div class="col-md-6">
                <div class="booking-im">
                    <img src="~/assets/marketplace/image/rectangle.png">
                </div>
            </div>
        </div>
    </div>
</section>

