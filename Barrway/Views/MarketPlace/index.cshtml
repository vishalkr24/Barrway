@model Barrway.DTO.MarketplaceModels.FeaturedCompanyList
@{
    ViewBag.Title = "Market Place";
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}

<style>
    .clr-tag {
        border-radius: 3px;
        padding: 3px;
        background-color: #e2476c;
        font-weight: 600;
        color: white;
        font-size: 12px;
    }

    .fields {
        display: flex;
    }

    @@media screen and (max-width:767px) {
        .fields {
            display: block;
        }
    }
</style>
<style>
    .skeleton-loader {
        width: 100%;
        margin: 0 auto;
        padding: 20px;
    }

    .skeleton-heading {
        width: 60%;
        height: 30px;
        margin-bottom: 20px;
        background-color: #f0f0f0; /* Change background color here */
        animation: pulse 1s infinite alternate;
    }

    .skeleton-carousel {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
    }

    .skeleton-item {
        flex: 0 0 200px; /* Adjust width as needed */
        height: 200px; /* Adjust height as needed */
        margin-right: 20px;
        background-color: #f0f0f0; /* Change background color here */
        animation: pulse 1s infinite alternate;
    }

    @@keyframes pulse {
        0% {
            opacity: 0.6;
        }

        100% {
            opacity: 1;
        }
    }

    .owl-carousel {
        display: ruby-text;
    }

    .mx-center {
        width: 100%;
        max-width: 80%;
        margin: 0 auto;
    }
    @@media screen and (max-width:767px) {
        .mx-center {
            max-width: 100%;
        }
    }
</style>
<!-- banner -->
<section class="top-banner">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="banner-form">
                    <h1>@Resource.Find_your_service__activity___book_it_in_one_stop</h1>

                    <div class="form-inner">
                        <p>@Resource.Find_a_service___activity_in_your_area!</p>
                        <div class="fields" style="align-items: baseline;">
                            <div class="form-group">
                                <label for="sel1">Category</label>
                                <select class="form-control" id="filter-category-master">
                                    <option>select a category</option>
                                    <option>1</option>
                                    <option>2</option>
                                    <option>3</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="sel1">@Resource.Subcategory</label>
                                <select class="form-control" id="filter-sub-category-master">
                                    <option>@Resource.Select_a_sub_category</option>
                                    <option>2</option>
                                    <option>3</option>
                                    <option>4</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="sel1">@Resource.District</label>
                                <select class="form-control" id="filter-district-master">
                                    <option>@Resource.Select_your_district</option>
                                    <option>2</option>
                                    <option>3</option>
                                    <option>4</option>
                                </select>
                            </div>
                            <p class="search"><a href="javascript:void(0)" onclick="setCalendarSubCategoryWise(true, true)"> <img src="~/assets/marketplace/image/search-icon.png"> </a></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="banner-image">
                    <img src="~/assets/marketplace/image/ban-img.png">
                </div>
            </div>
        </div>
    </div>
</section>

