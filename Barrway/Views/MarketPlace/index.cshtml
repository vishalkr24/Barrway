<!-- Barrway -->
<section class="Barrway mt-80">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="booking-text">
                    <h2>Hello Business Owners! Elevate Your Business with Barrway!</h2>
                    <p>Looking for ways to boost efficiency and customer satisfaction? Let us introduce you to Barrway! More than just a tool, Barrway is a comprehensive solution designed to help your business thrive.</p>
                    <p>By streamlining bookings, enhancing customer interactions, and providing insightful analytics, Barrway supports your growth every step of the way. Join a community of thriving businesses that are already seeing the benefits.</p>
                    <p><button class="learn-more"><a href="javascript:void(0)">Learn more</a></button></p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="booking-im">
                    <img src="~/assets/marketplace/image/rectangle.png">
                </div>
            </div>
        </div>
    </div>
</section>





<!-- sliders compnay -->
<section class="subcatageory" id="logo">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="my-slide featured-company">
                    <div class="heading-cata">
                        <h3>@Resource.Featured @Resource.Company</h3>
                    </div>
                    <div id="owl-demo-featured" class="owl-carousel owl-theme">
                        @if (Model.FeaturedCompanys != null)
                        {
                            foreach (var item in Model.FeaturedCompanys)
                            {
                                <div class="item" onclick="window.location.href = '/company/@item.COMPANY_CODE'">
                                    <div class="item-inner">
                                        <div class="pro-im">
                                            <img src="@item.COMPANY_LOGO_PATH.Replace("~", "")" onerror="this.src='../assets/marketplace/image/alogo2.png'"> 
                                        </div>
                                        <div class="pro-text">
                                            <p class="f1"><b>@item.COMPANY_NAME_ENGLISH</b></p>
                                            <p class="f2">
                                                @if (item.TAGs != null)
                                                {
                                                    foreach (var Titem in item.TAGs)
                                                    {
                                                        <a href="javascript:void(0)">@Titem.value</a>
                                                    }
                                                }

                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts{

    <script src="~/Scripts/MarketplaceScripts/homepage.js"></script>
}
