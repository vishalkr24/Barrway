
@{
    ViewBag.Title = @Resource.News;
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}
<style>
    div#owl-demo-blog .owl-item .item-inner .pro-im {
        min-height: 350px;
        max-height: 350px;
        background-color: #ddd;
        border: 1px solid #ddd;
        border-radius: 8px;
    }

    #owl-demo-blog .owl-dots.disabled {
        display: block !important;
    }

    #owl-demo-blog .owl-dots button.owl-dot.active span {
        background: #3fbfc8;
    }

    #owl-demo-blog .owl-dots .owl-dot span {
        background: transparent;
        border: 1px solid #3fbfc8;
    }

    .owl-dots button.owl-dot:focus {
        outline: none;
    }

    #owl-demo-blog h3.post_tittle {
        font-size: 24px;
        color: #000000;
        font-weight: 700;
        margin-bottom: 0px;
        margin-top: 15px;
        font-family: 'Poppins';
    }

    #owl-demo-blog p.fature {
        color: #E2476C;
        font-size: 18px;
        font-weight: 800;
        font-family: 'Poppins';
    }

    #owl-demo-blog p.date {
        color: #000000;
        font-family: 'Poppins';
        margin-bottom: 15px;
    }

    .button-slide {
        width: 100%;
        float: left;
        margin-bottom: 20px;
    }

        .button-slide button {
            background-color: transparent;
            color: #3fbfc8;
            border: 1px solid #4bc3cb;
            padding: 8px 25px;
            border-radius: 80px;
            margin-right: 10px;
        }

    .blog-post-vew .pro-im {
        display: block;
        min-height: 200px;
        max-height: 200px;
    }

        .blog-post-vew .pro-im img {
            width: 100%;
            min-height: 200px;
            max-height: 200px;
        }

    .blog-post-vew {
        position: relative;
    }

    .hot {
        position: absolute;
        top: 6px;
        left: 8px;
        color: #E2476C;
        font-weight: 600;
    }
</style>
