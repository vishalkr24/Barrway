@model Barrway.DTO.MarketplaceModels.BlogViewModel
@{
    ViewBag.Title = @Resource.News;
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}
<style>
    div#owl-demo-blog .owl-item .item-inner .pro-im {
        min-height: 350px;
        max-height: 350px;
        background-color: #ddd;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

        div#owl-demo-blog .owl-item .item-inner .pro-im img {
            min-height: 100%;
            max-height: 100%;
            object-fit: fill;
        }

    #owl-demo-blog .owl-dots.disabled {
        display: block !important;
    }

    #owl-demo-blog .owl-dots button.owl-dot.active span {
        background: #3fbfc8;
    }

    #owl-demo-blog .owl-dots .owl-dot span {
        background: transparent;
        border: 1px solid #3fbfc8;
    }

    .owl-dots button.owl-dot:focus {
        outline: none;
    }

    #owl-demo-blog h3.post_tittle {
        font-size: 24px;
        color: #000000;
        font-weight: 700;
        margin-bottom: 10px;
        margin-top: 15px;
        font-family: 'Poppins';
    }

        #owl-demo-blog h3.post_tittle a {
            font-size: 24px;
            color: #000000;
            font-weight: 700;
            margin-bottom: 0px;
            margin-top: 15px;
            font-family: 'Poppins';
            text-decoration: none;
        }

            #owl-demo-blog h3.post_tittle a:hover {
                color: #e2476c;
            }

    #owl-demo-blog p.fature {
        color: #E2476C;
        font-size: 18px;
        font-weight: 800;
        font-family: 'Poppins';
    }

    .blogimg img {
        border-radius: 10px;
    }

    #owl-demo-blog p.date {
        color: #000000;
        font-family: 'Poppins';
        margin-bottom: 15px;
    }

    .button-slide {
        width: 100%;
        float: left;
        margin-bottom: 20px;
    }

        .button-slide button {
            background-color: transparent;
            color: #3fbfc8;
            border: 1px solid #4bc3cb;
            padding: 8px 25px;
            border-radius: 80px;
            margin-right: 10px;
            white-space: nowrap;
        }

    .blog-post-vew .pro-im {
        display: block;
        min-height: 200px;
        max-height: 200px;
    }

        .blog-post-vew .pro-im img {
            width: 100%;
            min-height: 200px;
            max-height: 200px;
        }

    .blog-post-vew {
        position: relative;
    }

    .hot {
        position: absolute;
        top: 6px;
        left: 8px;
        color: #E2476C;
        font-weight: 600;
    }


    .pro-im img {
        border-radius: 10px;
    }

    /* Skeleton loader styles */


    /* Skeleton loader styles */
    .skeleton {
    background-color: #f2f2f2;
    border-radius: 5px;
    padding: 15px;
    margin-bottom: 20px;
}

.skeleton-image {
    width: 100%;
    height: 200px; /* Adjust height as needed */
    background-color: #ddd;
    border-radius: 5px;
}

.skeleton-text {
    width: 100%;
    height: 20px;
    background-color: #ddd;
    margin-bottom: 10px;
}

/* Loading animation */
@@keyframes loading {
    0% {
        opacity: 0.5;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 0.5;
    }
}

    .skeleton .hot::before {
        content: "";
        display: inline-block;
        width: 30px;
        height: 20px;
        /*background-color: #ddd;*/
        /*border-radius: 5px;*/
        /*animation: loading 1.5s infinite ease-in-out;*/

        background: rgba(130, 130, 130, 0.2);
        background: -webkit-gradient(linear, left top, right top, color-stop(8%, rgba(130, 130, 130, 0.2)), color-stop(18%, rgba(130, 130, 130, 0.3)), color-stop(33%, rgba(130, 130, 130, 0.2)));
        background: linear-gradient(to right, rgba(130, 130, 130, 0.2) 8%, rgba(130, 130, 130, 0.3) 18%, rgba(130, 130, 130, 0.2) 33%);
        background-size: 800px 100px;
        animation: wave-squares 2s infinite ease-out;
    }



</style>
<div id="list-view">
    <!-- bredcrum -->
    <section class="bredcrum">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="bredcrum-content">
                        <span><a href="/Marketplace/Index" style="color: #222;">@Resource.Home </a> </span> / <span><a href="/Marketplace/Blogs">Blogs</a> </span>

                    </div>
                </div>
                @*<div class="col-md-12">
                        <div class="news-banner">
                            <img src="~/assets/marketplace/image/news.jpg">
                        </div>
                    </div>*@

            </div>
        </div>
    </section>


    <section class="filser">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="blog-slide">
                        <div id="owl-demo-blog" class="owl-carousel owl-theme">

                            @if (Model.FeaturedBlogs != null)
                            {
                                foreach (var item in Model.FeaturedBlogs)
                                {

                                    <div class="item">
                                        <div class="item-inner">
                                            <div class="row">
                                                <div class="col-md-8">
                                                    <div class="blogimg">
                                                        @*<img src="~/assets/marketplace/image/alogo.png">*@
                                                        <a href="/MarketPlace/BlogDetails/@item.Id"><img src="@item.IMAGE" onerror="this.src='../assets/marketplace/image/dummy.jpg'"></a>


                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="pro-text">
                                                        <p class="fature">Featured post</p>
                                                        @*<h3 class="post_tittle">@item.BLOG_CONTENT</h3>*@
                                                        <h3 class="post_tittle"><a href="/MarketPlace/BlogDetails/@item.Id">@item.BLOG_TITLE</a></h3>
                                                        <p class="date">@item.created_at.ToString("yyyy-MM-dd HH:mm")</p>
                                                        <p class="tag">

                                                            @if (item.TAGs != null)
                                                            {
                                                                bool isFirst = true;
                                                                foreach (var Tagitem in item.TAGs)
                                                                {
                                                                    if (!isFirst)
                                                                    {
                                                                        <span>,</span>
                                                                    }

                                                                    <a href="/Marketplace/Search?keyword=@Tagitem.value"> @Tagitem.value</a>
                                                                    isFirst = false;
                                                                }
                                                            }

                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="button-slide">
                        <div id="owl-demo-button-slide" class="owl-carousel owl-theme">
                            @if (Model.TagList != null)
                            {

                                foreach (var tagItem in Model.TagList)
                                {

                                    <div class="item">
                                        <div class="item-inner">
                                            <button onclick="GetBlogs('1','@tagItem.TAG')">@tagItem.TAG</button>
                                        </div>
                                    </div>

                                }

                            }
                           
                        </div>

                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="filter fl-l">
                        <button class="filter-btn" onclick="GetHotBlogs()"><img src="~/assets/marketplace/image/filter.png" /> Hot </button>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="inner-content blogslist" style="min-height:540px;"> 
                        <div class="row" id="blogrow">
                            


                        </div>


                    </div>
                    <div class="pagination">
                        <button class="btn" onclick="setNewsData(1)"><img src="../assets/marketplace/image/p1.png"></button>
                        <button class="btn" id="next-page-nav" onclick="setNewsData(1)"><img src="/assets/marketplace/image/p12.png"></button>
                        <button class="btn" id="next-page-nav" onclick="setNewsData(2)"><img src="/assets/marketplace/image/p11.png"></button>
                        <button class="btn" id="last-page-nav" onclick="setNewsData(0)"><img src="/assets/marketplace/image/p2.png"></button>
                    </div>
                </div>
            </div>
        </div>
    </section>
   
    <script src="~/Scripts/MarketplaceScripts/Blog.js"></script>
</div>


