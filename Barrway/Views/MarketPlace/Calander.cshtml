                    }

                });


                $("input:hidden[name=" + uploaderId + "]").attr('value', value);


            }



            //$("input:hidden[name=" + id + "]").attr('value', "");


        }

        function generateInputBox(modelItem, id, additionalClass) {

            let value = "";

            switch (modelItem.type) {
                case "text":
                    value = `
                                            <label for="${modelItem.name}${id}">${modelItem.label} ${((modelItem.required == true) ? "*" : "")} ${((modelItem.description != undefined && modelItem.description != "") ? `<i class='fa fa-info-circle' aria-hidden='true' title='${modelItem.description}'></i>` : "")} </label>
                                            <input class="form-control ${additionalClass}" type="text" name="${modelItem.name}${id}" data-input-id="${id}" ${((modelItem.required == true) ? "required" : "")}/>`;
                    break;
                case "number":
                    value = `
                                            <label for="${modelItem.name}${id}">${modelItem.label}${((modelItem.required == true) ? "*" : "")} ${((modelItem.description != undefined && modelItem.description != "") ? `<i class='fa fa-info-circle' aria-hidden='true' title='${modelItem.description}'></i>` : "")} </label>
                                            <input class="form-control ${additionalClass}" type="number" name="${modelItem.name}${id}" data-input-id="${id}" ${((modelItem.required == true) ? "required" : "")}/>`;
                    break;
                case "date":
                    value = `
                                            <label for="${modelItem.name}${id}">${modelItem.label}${((modelItem.required == true) ? "*" : "")} ${((modelItem.description != undefined && modelItem.description != "") ? `<i class='fa fa-info-circle' aria-hidden='true' title='${modelItem.description}'></i>` : "")} </label>
                                            <input class="form-control ${additionalClass}" type="date" name="${modelItem.name}${id}" data-input-id="${id}" ${((modelItem.required == true) ? "required" : "")}/>`;
                    break;
                case "radio-group":
                    if (modelItem.values != null) {
                        value += `<label for="${modelItem.name}${id}">${modelItem.label} ${((modelItem.required == true) ? "*" : "")} ${((modelItem.description != undefined && modelItem.description != "") ? `<i class='fa fa-info-circle' aria-hidden='true' title='${modelItem.description}'></i>` : "")} </label> <br />`;

                        modelItem.values.forEach(x => {
                            value += `
                                                    <div style="float:left;">
                                                        <input type="radio" ${(x.selected == true) ? "checked" : ""} ${((modelItem.required == true) ? "required" : "")} class="" id="${modelItem.name}${x.value}${id}" name="${modelItem.name}${id}" value="${x.value}" data-input-id="${id}">
                                                        <label class="form-check-label" for="${modelItem.name}${x.value}${id}">${x.label}</label>
                                                    </div>
                                                    `
                        });
                    }
                    break;
                case "checkbox-group":
                    if (modelItem.values != null) {
                        value += `<label for="${modelItem.name}${id}">${modelItem.label} ${((modelItem.required == true) ? "*" : "")} ${((modelItem.description != undefined && modelItem.description != "") ? `<i class='fa fa-info-circle' aria-hidden='true' title='${modelItem.description}'></i>` : "")} </label> <br />`;
                        modelItem.values.forEach(x => {
                            value += `
                                                    <div style="float:left;">
                                                        <input type="checkbox" class="" id="${modelItem.name}${x.value}${id}" name="${modelItem.name}${id}" ${((modelItem.required == true) ? "required" : "")} value="${x.value}" data-input-id="${id}">
                                                        <label class="form-check-label" for="${modelItem.name}${x.value}${id}">${x.label}</label>
                                                    </div>
                                                    `
                        });
                    }
                    break;
                case "select":
                    if (modelItem.values != null) {
                        value += `<label for="${modelItem.name}${id}">${modelItem.label} ${((modelItem.required == true) ? "*" : "")} ${((modelItem.description != undefined && modelItem.description != "") ? `<i class='fa fa-info-circle' aria-hidden='true' title='${modelItem.description}'></i>` : "")} </label> <br /><select class="form-control" name="${modelItem.name}${id}" data-input-id="${id}" ${((modelItem.required != undefined && modelItem.required != '' && modelItem.required != 'N') ? "required" : "")}>`;
                        modelItem.values.forEach(x => {
                            value += `
                                                    <option value="${x.value}">${x.label}</option>
                                                    `
                        });
                        value += "</select>";
                    }
                    break;
                default:
                    break;
            }

            return value;
        }

        $(document).ready(function () {
            checkFavoriteCalendar();
        })

        function checkFavoriteCalendar() {
            var CalendarCode = $("#calendar-selector option:selected").val();

            $.ajax({
                url: "/Marketplace/CheckSingleFavoriteCalendar",
                type: "GET",
                data: {
                    CalendarCode: CalendarCode
                },
                success: function (response) {

                    if (response.Status) {
                        $("#favr").empty();
                        $("#favr-sm").empty();
                        setTimeout(function () {
                            $("#favr").append(`<button id="btn-mark-fav" onclick="removeAsFavorite('@Model.COMPANY_CODE')"><img src="/assets/marketplace/image/starg.png">Favorite</button>`);
                            $("#favr-sm").append(`<button id="btn-mark-fav" onclick="removeAsFavorite('@Model.COMPANY_CODE')"><img src="/assets/marketplace/image/starg.png">Favorite</button>`);
                        }, 500)

                    } else {
                        $("#favr").empty();
                        $("#favr-sm").empty();
                        setTimeout(function () {
                            $("#favr").append(`<button id="btn-mark" onclick="markAsFavorite('@Model.COMPANY_CODE')"><img src="/assets/marketplace/image/star.png"> @Resource.Mark_as_favorite</button>`)
                            $("#favr-sm").append(`<button id="btn-mark" onclick="markAsFavorite('@Model.COMPANY_CODE')"><img src="/assets/marketplace/image/star.png"> @Resource.Mark_as_favorite</button>`)
                        }, 500)

                    }


                }
            });

        }

        function markAsFavorite(CompanyCode) {

            var CalendarCode = $("#calendar-selector option:selected").val();

            $.ajax({
                url: "/Account/CheckPublicUserLogin",
                type: "POST",
                success: function (response) {

                    if (!response.Status) {

                        swal({
                            title: "Login Required",
                            text: "Kindly login into your account and then you can mark calendar as favorite.",
                            icon: "info",
                            buttons: {
                                confirm: "Login",
                                cancel: "Leave it"
                            }
                        }).then(function (value) {
                            if (value) {
                                window.location.href = '/Account/BusinessLogin?returnUrl=/Marketplace/Calander?' + window.location.href.split('?')[1].replace('&', '$') + '';
                            }
                        });

                    } else {

                        $.ajax({

                            url: "/UserAdmin/AddFavoriteCalendar",
                            type: "POST",
                            data: {
                                CALENDAR_CODE: CalendarCode,
                                COMPANY_CODE: CompanyCode
                            },
                            success: function (response) {
                                if (response.Status) {
                                    $("#btn-mark").remove();
                                    swal({
                                        title: "Marked Successfully!",
                                        text: "Calendar marked as favorite!",
                                        icon: "success",
                                        button: "Okay"
                                    }).then(function (boolValue) {
                                        $("#favr").empty();
                                        $("#favr").append(`<button id="btn-mark-fav" onclick="removeAsFavorite('@Model.COMPANY_CODE')"><img src="/assets/marketplace/image/starg.png">Favorite</button>`);
                                    });


                                } else {
                                    swal({
                                        title: "Mark Failed!",
                                        text: "Failed to mark calendar as favorite!",
                                        icon: "error",
                                        button: "Okay"
                                    });
                                }

                            }

                        })

                    }


                }
            });

        }

        function removeAsFavorite(CompanyCode) {

            var CalendarCode = $("#calendar-selector option:selected").val();

            $.ajax({
                url: "/Account/CheckPublicUserLogin",
                type: "POST",
                success: function (response) {

                    if (!response.Status) {
                        swal({
                            title: "Login Required",
                            text: "Kindly login into your account and then you can Unmark calendar as favorite.",
                            icon: "info",
                            buttons: {
                                confirm: "Login",
                                cancel: "Leave it"
                            }
                        }).then(function (value) {
                            if (value) {
                                window.location.href = '/Account/BusinessLogin?returnUrl=' + window.location.href + '';
                            }
                        });
                    } else {

                        $.ajax({

                            url: "/UserAdmin/RemoveFavoriteCalendar",
                            type: "POST",
                            data: {
                                CALENDAR_CODE: CalendarCode,
                                COMPANY_CODE: CompanyCode
                            },
                            success: function (response) {
                                if (response.Status) {
                                    $("#btn-unmark").remove();
                                    swal({
                                        title: "Unmarked Successfully!",
                                        text: "Calendar removed from favorites!",
                                        icon: "success",
                                        button: "Okay"
                                    }).then(function (boolValue) {
                                        $("#favr").empty();
                                        $("#favr").append(`<button id="btn-mark" onclick="markAsFavorite('@Model.COMPANY_CODE')"><img src="/assets/marketplace/image/star.png"> @Resource.Mark_as_favorite</button>`)
                                    });


                                } else {
                                    swal({
                                        title: "Unmark Failed!",
                                        text: "Failed to Unmark calendar as favorite!",
                                        icon: "error",
                                        button: "Okay"
                                    });
                                }



                            }

                        })

                    }


                }
            });

        }

