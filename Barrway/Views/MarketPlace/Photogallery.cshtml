@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyGalleryModel
@{
    ViewBag.Title = Resource.Company_Photo_Album;
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
    ViewBag.COMPANY_CODE = Model.COMPANY_CODE;
    ViewBag.COMPANY_LOGO_PATH = Model.COMPANY_LOGO_PATH.Replace("~", "");
    ViewBag.COMPANY_ID = Model.PAGE_URL.ToString();
    //ViewBag.COMPANY_ID = Model.COMPANY_CODE.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
}

<input id="txtCurrentCompanyCode" value="@ViewBag.COMPANY_CODE" readonly style="display:none;" />

<!-- heading -->
<section class="photo-album mihi-71">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="photo-album-inner">
                    <div class="gallery-wrapper">
                        <div class="gallery-inner">
                            @if (Model.photoAlbumList != null)
                            {
                                if (Model.photoAlbumList.Count > 0)
                                {
                                    foreach (var photo in Model.photoAlbumList)
                                    {
                                        <div class="gallery-img">
                                            <img src="@photo.ALBUM_PHOTO_PATH.Replace("~", "")" onerror="this.src='/assets/marketplace/image/hdiw.png'" alt="">
                                        </div>
                                    }
                                }
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section scripts{

    <script src="~/Scripts/MarketplaceScripts/CompanyPhotoAlbum.js"></script>
}
