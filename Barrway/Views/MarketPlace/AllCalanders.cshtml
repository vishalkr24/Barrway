                        <select class="form-control" id="filter-category-master">
                            <option value="Featured" selected="">Featured</option>
                            <option value="All" selected="">All</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                
                <div class="filter mt-25">
                    <button class="filter-btn"><img src="~/assets/marketplace/image/filter.png" /> @Resource.Filter</button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="Search">
                    @*<p>@Resource.Filter</p>
                        <div class="filter-tags">
                            <input type="text" name="filter" id="filter">
                        </div>*@
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="inner-content">
                    <div class="row">
                        <div class="col-md-6" id="row1">
                           
                        </div>
                        <div class="col-md-6" id="row2">
                           

                        </div>

                    </div>
                </div>
                <div class="pagination">

                </div>
            </div>
        </div>



    </div>

</section>

@section scripts{
    <script src="~/Scripts/MarketplaceScripts/AllCalanders.js"></script>
}