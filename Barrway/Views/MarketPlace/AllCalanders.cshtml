
@{
    ViewBag.Title = "AllCalanders";
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}
<style>
    .new-clr-tag {
        background-color: #e2476c;
        color: white;
        border-radius: 3px;
        padding: 3px;
    }
</style>
<section class="bredcrum">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="bredcrum-content">

                </div>
            </div>
        </div>
    </div>
</section>

<section class="heading">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">

                </div>
            </div>
        </div>
    </div>
</section>
<style>
    .skeleton-loader {
        margin-top: 20px;
    }

    .skeleton-media {
        margin-bottom: 20px;
    }

    .skeleton-media-left {
        width: 351px; /* Adjust width of image placeholder */
        height: 95px; /* Adjust height of image placeholder */
        background-color: #f0f0f0; /* Background color for image placeholder */
        margin-right: 10px;
        border-radius: 10px;
    }

    .skeleton-media-body {
        flex: 1;
    }

    .skeleton-heading {
        width: 60%;
        height: 20px; /* Adjust height of heading placeholder */
        background-color: #f0f0f0; /* Background color for heading placeholder */
        margin-bottom: 10px;
        margin-left: 23px;
    }


    .skeleton-text {
        height: 13px; /* Adjust height of text line */
        width: 60%; /* Adjust width of text line */
        background-color: #e9e9e9; /* Background color for text placeholder */
        margin-bottom: 8px;
        margin-left: 23px;
    }

    .Scmedia-body {
        width: 601px !important;
    }
    .skeleton-media {
        margin-bottom: 20px;
        animation: skeleton-animation 1.5s infinite ease-in-out; /* Apply animation to media container */
    }
    @@keyframes skeleton-animation {
    0% {
        opacity: 0.5;
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 0.5;
    }
}
</style>
<!-- heading -->
<section class="filser custome-filser">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <div class="Search custome-ser">
                    <div class="form-group">
                        <label for="sel1">@Resource.Sort</label>
                        <select class="form-control" id="filter-category-master">
                            <option value="Featured" selected="">Featured</option>
                            <option value="All" selected="">All</option>

                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                
                <div class="filter mt-25">
                    <button class="filter-btn"><img src="~/assets/marketplace/image/filter.png" /> @Resource.Filter</button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="Search">
                    @*<p>@Resource.Filter</p>
                        <div class="filter-tags">
                            <input type="text" name="filter" id="filter">
                        </div>*@
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="inner-content">
                   

                    <div class="row" id="Content-row">


                    </div>
                </div>
                <div class="pagination">

                </div>
            </div>
        </div>



    </div>

</section>

@section scripts{
    <script src="~/Scripts/MarketplaceScripts/AllCalanders.js"></script>
}