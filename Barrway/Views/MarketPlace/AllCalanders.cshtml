
@{
    ViewBag.Title = "AllCalanders";
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}
<style>
    .new-clr-tag {
        background-color: #e2476c;
        color: white;
        border-radius: 3px;
        padding: 3px;
    }
</style>
<section class="bredcrum">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="bredcrum-content">

                </div>
            </div>
        </div>
    </div>
</section>

<section class="heading">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">

                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="filser custome-filser">
