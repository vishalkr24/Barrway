@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel
@{
    ViewBag.Title = Resource.Company_Service;
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
    ViewBag.COMPANY_LOGO_PATH = Model.COMPANY_LOGO_PATH.Replace("~", "..");
    ViewBag.COMPANY_ID = Model.COMPANY_CODE.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
}


<!-- heading -->
<section class="heading company-detail-hed">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">
                    <h2>@Model.COMPANY_NAME_ENGLISH (@Model.COMPANY_NAME_CHINESE)</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="company-detail-main">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="cd-banner" style="min-height:70vh">
                    @Html.Raw(Model.COMPANY_SERVICE)
                </div>
            </div>
        </div>
        
    </div>
</section>



@section scripts{

    <script src="~/Scripts/MarketplaceScripts/CompanyService.js"></script>
}