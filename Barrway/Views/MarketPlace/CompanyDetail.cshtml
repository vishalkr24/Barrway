@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel
@{
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
    ViewBag.COMPANY_LOGO_PATH = Model.COMPANY_LOGO_PATH.Replace("~", "..");
    ViewBag.COMPANY_ID = Model.COMPANY_CODE.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
    int TemplateId = (string.IsNullOrEmpty(Model.TEMPLATE_ID)) ? 1 : Convert.ToInt32(Model.TEMPLATE_ID);
    int PaletteId = (string.IsNullOrEmpty(Model.PALETTE_ID)) ? 1 : Convert.ToInt32(Model.PALETTE_ID);
}

@section styles{
    <link href="~/assets/css/website-template-root-variables.css" rel="stylesheet" />
    <link href="~/assets/css/website-template-manager.css" rel="stylesheet" />
}

<input id="hiddenInputPaletteId" value="@PaletteId" readonly style="display:none;" />
<input id="hiddenInputTemplateId" value="@TemplateId" readonly style="display:none;" />

@RenderPage("~/Views/WebsiteTemplates/_Template" + TemplateId + ".cshtml", Model)

@section scripts{
    <script src="~/Scripts/MarketplaceScripts/WebsiteTemplateManager.js"></script>
    <script src="~/Scripts/MarketplaceScripts/CompanyDetail.js"></script>
}