@model Barrway.DTO.PublicModels.PublicTagDataModel
@{
    ViewBag.Title = "Tag";
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}

<!-- bredcrum -->
<section class="bredcrum">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="bredcrum-content">
                    <span><a href="/Marketplace/Index" style="color: #222;">Home </a> </span> / <span><a href="#">@ViewBag.TagName </a> </span>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- heading -->
<section class="heading">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">
                    <h2>@ViewBag.TagName</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="filser">
    <div class="container tag">
        <div class="row">
            <div class="col-md-12">
                <div class="inner-content">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="sub-hed">
                                <p>Service contains @ViewBag.TagName</p>
                            </div>
                        </div>
                        @foreach (var item in Model.calendars)
                        {
                            <div class="col-md-6">
                                <div class="media">
                                    <div class="media-left" style="" onclick="viewMarketplaceCompanyCalendar('@item.COMPANY_CODE', '@item.CALENDAR_CODE')">
                                        <img src="@item.CALENDAR_PHOTO_PATH.Replace("~", "..")" onerror="this.src='../assets/marketplace/image/pro.png'" class="media-object" style="width:150px">
                                    </div>
                                    <div class="media-body">
                                        <h4 class="media-heading">@item.COMPANY_NAME_ENGLISH</h4>
                                        <p><b>@item.CALENDAR_NAME</b></p>
                                        <p>@item.CITY_NAME</p>
                                        <p>
                                            @{
                                                if (!string.IsNullOrEmpty(item.TAGS))
                                                {
                                                    var tags = item.TAGS.Split(',');
                                                    for (int i = 0; i < tags.Length; i++)
                                                    {
                                                        <a href="/Marketplace/Tag?tag=@tags[i].Trim()"> @tags[i],</a>
                                                    }
                                                }
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="sub-hed">
                                <p>Company contains @ViewBag.TagName</p>
                            </div>
                        </div>
                        @foreach (var item in Model.companies)
                        {
                            <div class="col-md-6">
                                <div class="media">
                                    <div class="media-left">
                                        <img src="@item.COMPANY_LOGO_PATH.Replace("~", "..")" onerror="this.src='../assets/marketplace/image/tagre.png'" class="media-object" style="width:150px">
                                    </div>
                                    <div class="media-body">
                                        <h4 class="media-heading">@item.COMPANY_NAME_ENGLISH</h4>
                                        <p>
                                            @{
                                                if (!string.IsNullOrEmpty(item.TAGS))
                                                {
                                                    var tags = item.TAGS.Split(',');
                                                    for (int i = 0; i < tags.Length; i++)
                                                    {
                                                        <a href="/Marketplace/Tag?tag=@tags[i].Trim()"> @tags[i],</a>
                                                    }
                                                }
                                            }
                                        </p>
                                        <p style="height:46px; overflow:hidden;">@item.COMPANY_DESCRIPTION</p>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                    @*<div class="row">
                            <div class="col-md-12">
                                <div class="sub-hed">
                                    <p>Blog contains Tag1</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="media">
                                    <div class="media-left">
                                        <img src="~/assets/marketplace/image/tagre.png" class="media-object" style="width:150px">
                                    </div>
                                    <div class="media-body">
                                        <p><a href="">Tag1</a></p>
                                        <h4 class="media-heading">Post title</h4>
                                        <p><span>Author name,</span> <span>YYYY-MM-DD</span></p>

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="media">
                                    <div class="media-left">
                                        <img src="~/assets/marketplace/image/tagre.png" class="media-object" style="width:150px">
                                    </div>
                                    <div class="media-body">
                                        <p><a href="">Tag1</a></p>
                                        <h4 class="media-heading">Post title</h4>
                                        <p><span>Author name,</span> <span>YYYY-MM-DD</span></p>

                                    </div>
                                </div>
                            </div>
                        </div>*@
                </div>
            </div>
        </div>
    </div>

</section>
