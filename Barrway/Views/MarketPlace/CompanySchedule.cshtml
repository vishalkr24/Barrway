<section class="schedule mihi-71" ng-app="myApp" ng-controller="myCtrl">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="schdule-inner">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="schedule-drop">
                                <div class="form-group">
                                    <label for="calendar">Calendar</label>

                                    <select class="form-control" id="calendar-selector" onchange="showCalendar('@Model.COMPANY_CODE')">
                                        <option value="-1" disabled selected>select a calendar</option>
                                        @foreach (var item in Model.calendars)
                                        {
                                            <option value="@item.CALENDAR_CODE" @((item.Id == Model.DEFAULT_CALENDAR_ID) ? "selected" : "")>@item.CALENDAR_NAME</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="schedule-drop">
                                <div class="form-group">
                                    <label for="service">Service</label>

                                    <select class="form-control" id="calendar-service">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="favr">
                                <button><img src="~/assets/marketplace/image/star.png"> Mark as favorite</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div id="calendar" style="padding: 0px; margin-top: 15px;">

                        <div id="tabs" style="display:none">
