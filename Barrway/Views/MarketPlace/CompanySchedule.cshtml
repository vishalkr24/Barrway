@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel
@{
    ViewBag.Title = "Company Schedule";
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
    ViewBag.COMPANY_LOGO_PATH = Model.COMPANY_LOGO_PATH.Replace("~", "..");
    ViewBag.COMPANY_ID = Model.COMPANY_CODE.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
}

<section class="schedule mihi-71">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="schdule-inner">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="schedule-drop">
                                <div class="form-group">
                                    <label for="calendar">Calendar</label>
                                    
                                    <select class="form-control" id="calendar-selector" onchange="showCalendar('@Model.COMPANY_CODE')">
                                       <option value="-1" disabled selected>select a calendar</option>
                                       @foreach (var item in Model.calendars)
                                       {
                                           <option value="@item.Id" @((item.Id == Model.DEFAULT_CALENDAR_ID)? "selected": "")>@item.CALENDAR_NAME</option>
                                       }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="schedule-drop">
                                <div class="form-group">
                                    <label for="service">Service</label>

                                    <select class="form-control" id="service">
                                        @foreach (var item in Model.services)
                                        {
                                            <option value="@item.Id">@item.COMPANY_CATEGORY_NAME</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="favr">
                                <button><img src="~/assets/marketplace/image/star.png"> Mark as favorite</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section scripts{

    <script src="~/Scripts/MarketplaceScripts/CompanySchedule.js"></script>
}
