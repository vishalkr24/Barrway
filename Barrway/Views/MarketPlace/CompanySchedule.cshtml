
@{
    ViewBag.Title = "Company Schedule";
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
}

<section class="schedule mihi-71">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="schdule-inner">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="schedule-drop">
                                <div class="form-group">
                                    <label for="calendar">Calendar</label>
                                    <select class="form-control" id="calendar">
                                        <option>Yoga</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="schedule-drop">
                                <div class="form-group">
                                    <label for="service">Service</label>
                                    <select class="form-control" id="service">
                                        <option>All service</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="favr">
                                <button><img src="~/assets/marketplace/image/star.png"> Mark as favorite</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


