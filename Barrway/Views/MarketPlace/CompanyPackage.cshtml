@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel
@{
    ViewBag.Title = "Company Package";
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";
    ViewBag.COMPANY_ID = Model.COMPANY_CODE.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
}


<!-- heading -->
<section class="heading company-detail-hed">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">
                    <h2>@Model.COMPANY_NAME_ENGLISH (@Model.COMPANY_NAME_CHINESE)</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="company-detail-main mihi-71">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="card-pakage">
                    <div class="card-top-detail">
                        <div class="media">
                            <div class="media-left">
                                <img src="~/assets/marketplace/image/pro.png" class="media-object" style="width:195px">
                            </div>
                            <div class="media-body">
                                <h4 class="media-heading">Yoga and health class (calendar name)</h4>
                                <p><span class="location">Location</span></p>
                                <p>
                                    <span> Subcategory1, </span>
                                    <span>  Subcategory1, </span>
                                    </br>
                                    <span> Service name1, </span>
                                    <span> Service name2, </span>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="card-bottom">
                        <div class="bpgd">
                            <h4>Basic plan</h4>
                            <h4>HK$1000 = B$1000</h4>
                            <p>Description:</p>
                            <p>Regular course is B$ 100 per class</p>
                            <p class="mt-10"><button>BUY</button></p>
                        </div>
                        <div class="bpgd">
                            <h4>Great deal</h4>
                            <h4>HK$5000 = B$5800</h4>
                            <p>Description:</p>
                            <p>Regular course is B$ 100 per class</p>
                            <p class="mt-10"><button>BUY</button></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section scripts{

    <script src="~/Scripts/MarketplaceScripts/CompanyPackage.js"></script>
}