
@{
    ViewBag.Title = Resource.Business_Site;
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}

<style>
    .skeleton-loader {
        margin-top: 20px;
    }

    .skeleton-media {
        margin-bottom: 20px;
    }

    .skeleton-media-left {
        width: 351px; /* Adjust width of image placeholder */
        height: 95px; /* Adjust height of image placeholder */
        background-color: #f0f0f0; /* Background color for image placeholder */
        margin-right: 10px;
        border-radius: 10px;
    }

    .skeleton-media-body {
        flex: 1;
    }

    .skeleton-heading {
        width: 60%;
        height: 20px; /* Adjust height of heading placeholder */
        background-color: #f0f0f0; /* Background color for heading placeholder */
        margin-bottom: 10px;
        margin-left: 23px;
    }


    .skeleton-text {
        height: 13px; /* Adjust height of text line */
        width: 60%; /* Adjust width of text line */
        background-color: #e9e9e9; /* Background color for text placeholder */
        margin-bottom: 8px;
        margin-left: 23px;
    }

    .Scmedia-body {
        width: 601px !important;
    }

    .skeleton-media {
        margin-bottom: 20px;
        animation: skeleton-animation 1.5s infinite ease-in-out; /* Apply animation to media container */
    }

    @@keyframes skeleton-animation {
        0% {
            opacity: 0.5;
        }

        50% {
            opacity: 1;
        }

        100% {
            opacity: 0.5;
        }
    }

    .media-left img {
        min-width: 200px;
        min-height: 132px;
        max-height: 132px;
        object-fit: contain;
    }
</style>
<!-- heading -->
<section class="heading">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">
                    <h2>@Resource.Business</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="filser">
    <div class="container">
        <div class="row">
            <div class="col-md-2">
                <div class="filter">
                    <p>@Resource.Sort</p>
                    <button class="filter-btn"><img src="~/assets/marketplace/image/filter.png" /> @Resource.Filter</button>
                </div>
            </div>
            <div class="col-md-10">
                <div class="Search">
                    <p>@Resource.Filter</p>
                    <div class="filter-tags">
                        <input type="text" name="filter" id="filter">
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="inner-content company-content">                    
                    <div class="row" id="ComapanyList">
                        

                    </div>
                </div>
                <div class="pagination">

                </div>
            </div>
        </div>



    </div>

</section>

@section scripts{
    <script src="~/Scripts/MarketplaceScripts/BusinessSite.js"></script>
}

