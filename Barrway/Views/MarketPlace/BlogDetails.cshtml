
@{
    ViewBag.Title = "Blog Details";
    Layout = "~/Views/Shared/_LayoutMarketPlace.cshtml";
}
<style>
    .single-blog-post-vew .post-title {
        font-size: 24px;
    }

    .single-blog-post-vew .tag {
        font-size: 16px;
    }

    .single-blog-post-vew {
        width: 100%;
        float: left;
        margin-top: 30px;
    }

        .single-blog-post-vew .pro-text {
            margin-bottom: 15px;
        }

        .single-blog-post-vew .pro-im {
            display: block;
            min-height: 300px;
            max-height: 300px;
            margin-bottom: 15px;
        }

            .single-blog-post-vew .pro-im img {
                width: 100%;
                min-height: 300px;
                max-height: 300px;
                border-radius:8px;
            }
    .single-blog-details {
        width: 100%;
        float: left;
    }
    .social-img {
        width: 100%;
        float: left;
        margin-top: 15px;
    }
    .blod-sidebar {
        width: 100%;
        float: left;
        margin-top: 80px;
        height: 75vh;
        overflow-y: auto;
    }
</style>
