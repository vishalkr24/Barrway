        function markAsFavorite(CompanyCode) {

            var CalendarCode = $("#calendar-selector option:selected").val();

            $.ajax({
                url: "/Account/CheckPublicUserLogin",
                type: "POST",
                success: function (response) {

                    if (!response.Status) {

                        swal({
                            title: "Login Required",
                            text: "Kindly login into your account and then you can mark calendar as favorite.",
                            icon: "info",
                            buttons: {
                                confirm: "Login",
                                cancel: "Leave it"
                            }
                        }).then(function (value) {
                            if (value) {
                                window.location.href = '/Account/Login?returnUrl=/Marketplace/Calander?' + window.location.href.split('?')[1].replace('&', '$') + '';
                            }
                        });

                    } else {

                        $.ajax({

                            url: "/UserAdmin/AddFavoriteCalendar",
                            type: "POST",
                            data: {
                                CALENDAR_CODE: CalendarCode,
                                COMPANY_CODE: CompanyCode
                            },
                            success: function (response) {
                                if (response.Status) {
                                    $("#btn-mark").remove();
                                    swal({
                                        title: "Marked Successfully!",
                                        text: "Calendar marked as favorite!",
                                        icon: "success",
                                        button: "Okay"
                                    }).then(function (boolValue) {
                                        window.location.reload();
                                    });


                                } else {
                                    swal({
                                        title: "Mark Failed!",
                                        text: "Failed to mark calendar as favorite!",
                                        icon: "error",
                                        button: "Okay"
                                    });
                                }

                            }

                        })

                    }


                }
            });

        }

        function removeAsFavorite(CompanyCode) {

            var CalendarCode = $("#calendar-selector option:selected").val();

            $.ajax({
                url: "/Account/CheckPublicUserLogin",
                type: "POST",
                success: function (response) {

                    if (!response.Status) {
                        swal({
                            title: "Login Required",
                            text: "Kindly login into your account and then you can Unmark calendar as favorite.",
                            icon: "info",
                            buttons: {
                                confirm: "Login",
                                cancel: "Leave it"
                            }
                        }).then(function (value) {
                            if (value) {
                                window.location.href = '/Account/Login?returnUrl=/Marketplace/Calander?' + window.location.href.split('?')[1].replace('&', '$') + '';
                            }
                        });
                    } else {

                        $.ajax({

                            url: "/UserAdmin/RemoveFavoriteCalendar",
                            type: "POST",
                            data: {
                                CALENDAR_CODE: CalendarCode,
                                COMPANY_CODE: CompanyCode
                            },
                            success: function (response) {
                                if (response.Status) {
                                    $("#btn-unmark").remove();
                                    swal({
                                        title: "Unmarked Successfully!",
                                        text: "Calendar removed from favorites!",
                                        icon: "success",
                                        button: "Okay"
                                    }).then(function (boolValue) {
                                        window.location.reload();
                                    });


                                } else {
                                    swal({
                                        title: "Unmark Failed!",
                                        text: "Failed to Unmark calendar as favorite!",
                                        icon: "error",
                                        button: "Okay"
                                    });
                                }



                            }

                        })

                    }


                }
            });

        }

    </script>

}
