<input id="currentCalendarCode" value="@Model.DEFAULT_CALENDAR_ID" readonly disabled style="display:none;" />
<input id="currentCompanyCode" value="@Model.COMPANY_CODE" readonly disabled style="display:none;" />

<section class="schedule mihi-71" style="background: #ECFAFB; margin-top:4px;" ng-controller="marketplaceQueueController" ">
    <input id="currentUserId" value="@((User.Identity.IsAuthenticated)? User.Identity.Name: null)" readonly disabled style="display:none;" />
    <div class="container-fluid" id="quequeDiv">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">


                    <div class="schdule-inner">
                        <div class="row">
                            <div class="col-md-6">
                                <h2 style="font-weight:bold;">@Model.COMPANY_NAME_ENGLISH (@Model.COMPANY_NAME_CHINESE)</h2>
                            </div>

                            <div class="col-md-6">
                                <div class="favr">
                                    @if (!ViewBag.IsUserFavorite)
                                    {
                                        <button id="btn-mark" onclick="markAsFavorite('@Model.COMPANY_CODE')"><img src="~/assets/marketplace/image/star.png"> @Resource.Mark_as_favorite</button>
                                    }
                                    else
                                    {
                                        <button id="btn-unmark" onclick="removeAsFavorite('@Model.COMPANY_CODE')"><img src="~/assets/marketplace/image/star.png"> @Resource.Remove_as_favorite</button>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="queue_view">
                <div class="row" style="margin-top: 3rem;">
                    <div class="col-md-12">
                        <div class="queue-area" id="queue-area">
                            <div class="queue-list-area same-row" style="flex-flow: row wrap;" id="queue-external-area">
                                <div class="queue-element" ng-repeat="queue in queueList" ng-if="queue.QUEUE_USAGE == 'TICKET'" data-queue-id="{{queue.Id}}">

                                    <div class="queue_backlog_second">
                                        <div class="queue_backlog_inner">
                                            <div class="queue-back-log">
                                                <div style="padding:1.5rem; padding-top:0px;">
                                                    <h2 style="padding-bottom:8px;"><b>({{queue.QUEUE_PREFIX}}) {{queue.QUEUE_NAME}}</b></h2>
                                                    <h4 class="pink" style="margin-bottom:4px;"><span>Current</span> <b>{{queue.CurrentTicket}}</b></h4>
                                                    <span>@DateTime.Now.ToString("hh:mm tt")</span>
                                                </div>


                                                <div class="text-center">
                                                    <div class="hr"></div>
                                                    <h3 class="current-ticket-number">{{queue.AvailableTicket}}</h3>
                                                </div>
                                                <div class="call-button" style="padding: 0px 1.5rem;">
                                                    <button ng-click="bookTicket(queue.Id)">Get Ticket</button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

