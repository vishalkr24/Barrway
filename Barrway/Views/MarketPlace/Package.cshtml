@model Barrway.DTO.MarketplaceModels.MarketplaceCompanyModel
@{
    ViewBag.Title = Resource.Company_Package;
    Layout = "~/Views/Shared/_LayoutMarketPlaceCompany.cshtml";

    ViewBag.COMPANY_CODE = Model.COMPANY_CODE.ToString();
    ViewBag.COMPANY_ID = Model.PAGE_URL.ToString();
    ViewBag.CALENDAR_ID = Model.DEFAULT_CALENDAR_ID;
    ViewBag.COMPANY_LOGO_PATH = Model.COMPANY_LOGO_PATH.Replace("~", "");
}
<input id="txtCurrentCompanyCode" value="@ViewBag.COMPANY_CODE" readonly style="display:none;"/>
<input id="txtCurrentCalendarCode" value="@ViewBag.CALENDAR_ID" readonly style="display:none;" />

<!-- heading -->
<section class="heading company-detail-hed">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="head">
                    <h2>@Model.COMPANY_NAME_ENGLISH (@Model.COMPANY_NAME_CHINESE)</h2>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- heading -->
<section class="company-detail-main mihi-71">
    <div class="container">
        <div class="row">
            <div class="col-md-12" id="calendars-area">
                
            </div>
        </div>
    </div>

    <form action="/Payment/OrderDetails" method="post" id="paymentForm" style="display:none;"><input id="txtPackageName" name="Id"/></form>
</section>


@section scripts{

    <script src="~/Scripts/MarketplaceScripts/CompanyPackage.js"></script>
}