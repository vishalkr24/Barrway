                    icon: ("@ViewBag.SuccessMessage" != null) ? "success" : "error",
                    title: ("@ViewBag.SuccessMessage" != null) ? "Success" : "Error",
                    text: ("@ViewBag.SuccessMessage" != null) ? "@ViewBag.SuccessMessage" : "@ViewBag.ErrorMessage",
                })
            }
        });
    </script>
    <script>

        $(document).ready(function () {
            $.fn.bstooltip = $.fn.tooltip.noConflict(true);

            // handle if the user is logged out but not on screen

            checkLogin();

        })

        function checkLogin() {

            $.ajax({
                url: "/public/GetRole",
                type: "get",
                success: function (response) {
                    if (response != "BUSINESS_USER" && response != "SUPERADMIN_USER" && response != "GENERAL_USER") {
                        window.location.href = "/Account/BusinessLogin"
                    }
                }
            })


        }

        $('.nav-link').click(function () {

            $('.nav-link').not(this).removeClass('active');
            $(this).addClass('active');
        });

        document.querySelectorAll(".nav-link").forEach((link) => {
            if (link.href === window.location.href) {
                $('.nav-link').not(this).removeClass('active');
                link.classList.add("active");
                link.setAttribute("aria-current", "page");
            }
        });



    </script>

