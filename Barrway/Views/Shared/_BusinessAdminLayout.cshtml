    var webapibaseurl = System.Web.Configuration.WebConfigurationManager.AppSettings["webapibaseurl"].ToString();
    string token = DateTime.Now.ToString("ddMMyyyyHHmmssffffff");
    string calendarUrl = baseUrl + "calendar/index";

    HttpCookie languageCookie = System.Web.HttpContext.Current.Request.Cookies["Language"];
    string language = "";
    if (languageCookie != null)
