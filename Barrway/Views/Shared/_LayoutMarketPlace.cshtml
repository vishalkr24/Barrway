    <script>
        $(document).ready(function () {
            fetch('https://api.geoapify.com/v1/ipinfo?apiKey=4006c325508045ae973962551e377999')
                .then(response => response.json())
                .then(data => {
                    $("#location").append(data.country.name);
                    // You can now access the location data in the "data" object
                    console.log(data);
                }
                );


            getAllSubcategory();

        })


        function getAllSubcategory() {
            $.ajax({
                url: '/MarketPlace/GetAllSubcategory',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    // Handle successful response

                    // Access the returned data, for example:
                    var subcategories = response.data.Data;
                    //console.log(subcategories, "subcategories");
                    populateDropdownMenu(subcategories);

                    // Process the subcategories as needed
                },
                error: function (xhr, status, error) {
                    // Handle error
                    console.error('Error:', error);
                }
            });
        }


        function populateDropdownMenu(data) {
            var dropdownMenu = $('.dropdown-menu.subcatageory');
            dropdownMenu.empty(); // Clear existing items

            // Loop through the JSON data and create dropdown menu items
            $.each(data, function (index, item) {
                var listItem = $('<li>');
                var anchor = $('<a>').attr('href', '/Marketplace/AllCalanders?subcategory=' + item.Id +'').text(item.CALENDAR_SUB_CATEGORY_NAME);
                listItem.append(anchor);
                dropdownMenu.append(listItem);
            });
        }

    </script>
</body>
