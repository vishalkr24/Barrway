        function changeLanguage() {
            localStorage.setItem("globalLang", $("select[name=langId] option:selected").val())
            localStorage.setItem("globalLangForm", $("select[name=langId] option:selected").val())

            $("#langForm").attr("action", "/Marketplace/ChangeLanguage?ReturnUrl=" + window.location.href)

            document.getElementById('langForm').submit()
        }
