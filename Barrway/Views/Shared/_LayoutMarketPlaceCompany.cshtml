                    </button>
                    <a class="navbar-brand" href="/Marketplace/Index"><img src="~/assets/marketplace/image/logo.png"></a>
                </div>
                <form class="navbar-form navbar-left com-nav" action="/action_page.php">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Search">
                        <div class="input-group-btn">
                            <button class="btn btn-default" type="submit">
                                <i class="glyphicon glyphicon-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
                <div class="collapse navbar-collapse" id="com-nav">
                    <ul class="nav navbar-nav navbar-right">
                        <li class="active"><a href="/Marketplace/Index">Home</a></li>
                        <li>
                            <a class="" href="/Marketplace/BusinessSite">Business <span class="caret"></span></a>
                            <!-- <ul class="dropdown-menu">
                              <li><a href="#">Page 1-1</a></li>
                              <li><a href="#">Page 1-2</a></li>
                              <li><a href="#">Page 1-3</a></li>
                            </ul> -->
                        </li>
                        <li><a href="/Marketplace/News">News</a></li>
                        <li><a href="/Account/BusinessSignup">Post your business</a></li>
                        <li class="rl">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="/Useradmin"> Account</a>
                            <ul class="dropdown-menu">
                                <li><a href="#">Register</a></li>
                                <li>
                                    <a href="#">
                                        Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
