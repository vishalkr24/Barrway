
@{
    var baseUrl = System.Web.Configuration.WebConfigurationManager.AppSettings["baseURL"].ToString();
    string token = DateTime.Now.ToString("ddMMyyyyHHmmssffffff");
}
<!DOCTYPE html>

<html>
<head>
