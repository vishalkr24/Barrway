                                        userabbr += UserIdentity.UserLastName[0];
                                    }
                                }
                                else
                                {
                                    userabbr = UserIdentity.UserName[0].ToString();
                                }
                                if (!string.IsNullOrEmpty(ViewBag.ProfilePic))
                                {
                                    <img src="@ViewBag.ProfilePic.Replace("~", "")" onclick="window.location.href = '/Useradmin#/dashboard'" onerror="this.src='/assets/img/160x160/img6.jpg'" style="width: 40px; height: 40px; border-radius: 50px;">
                                }
                                else
