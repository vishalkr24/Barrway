                                string userabbr = "";
                                if (!string.IsNullOrEmpty(UserIdentity.UserFirstName))
                                {
                                    userabbr = UserIdentity.UserFirstName[0].ToString();
                                    if (!string.IsNullOrEmpty(UserIdentity.UserLastName))
                                    {
                                        userabbr += UserIdentity.UserLastName[0];
                                    }
                                }
                                else
                                {
                                    userabbr = UserIdentity.UserName[0].ToString();
                                }



                                @*<a href="/Useradmin#/myprofile" id="nav-user-icon" style="text-transform:uppercase;">@userabbr </a>*@
                                if (!string.IsNullOrEmpty(ViewBag.ProfilePic))
                                {
                                    <img src="@ViewBag.ProfilePic.Replace("~", "")" onclick="window.location.href = '/Useradmin#/myprofile'" onerror="this.src='/assets/img/160x160/img6.jpg'" style="width: 40px; height: 40px; border-radius: 50px;">
                                }
                                else
                                {
                                    <a class="dropdown-toggle" href="/Useradmin#/dashboard">@userabbr</a>
                                }

                            }
                            else
                            {
                                <a class="dropdown-toggle" href="/Account/BusinessLogin">B</a>
                            }
                        </li>
                    </ul>
                    <button type="button" class="navbar-toggle secondry-nav collapsed" data-toggle="collapse" data-target="#secondry-nav">
