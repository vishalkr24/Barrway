    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>*@

    <!-- font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Owl Stylesheets -->
    <link rel="stylesheet" href="~/assets/marketplace/owl/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/marketplace/owl/owl.theme.default.min.css">

    <!-- javascript -->
    <script>
        var BASE_URL = '@baseUrl';
        var ASSET_URL = '@baseUrl';
    </script>

    <script src="/assets/js/vendor.min.js"></script>

    <script src="~/assets/marketplace/owl/jquery.min.js"></script>
    <script src="~/assets/marketplace/owl/owl.carousel.js"></script>
    <script src="~/Scripts/PublicCommonFunction.js"></script>


    <!-- css -->
    <link rel="stylesheet" type="text/css" href="~/assets/marketplace/css/style.css">
