                                    <a class="dropdown-toggle" href="/Useradmin#/myprofile">@userabbr</a>
                                }

                            }
                            else
                            {
                                <a href="/Account/BusinessLogin" id="nav-user-icon" style="text-transform:uppercase;">B</a>
                            }

                        </li>
                    </ul>

                </div>
