
@{
    ViewBag.Title = Resource.Pricing;
    Layout = "~/Views/Shared/_LayoutBusinessMarketPlace.cshtml";
}

<style>
    /*=============================*/
    .heading h2 {
        font-weight: 700;
        font-size: 24px;
        line-height: 30px;
        color: #222222;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-custome {
        width: 25%;
        max-width: 340px;
        float: left;
        padding: 0px 5px;
    }

    .pricing-custome-inner {
        width: 100%;
        float: left;
        border: 1px solid #CCCCCC;
        border-radius: 15px;
        margin-top: 30px;
    }

    .pricing-body {
        padding: 0px 15px;
        width: 100%;
        float: left;
    }

    .heder-price {
        border-radius: 15px 15px 0px 0px;
        width: 100%;
        float: left;
        height: 20px;
    }

    .pricing-body h3 {
        font-weight: 600;
        font-size: 18px;
        line-height: 24px;
        height: 24px;
        color: #222222;
        margin-top: 20px;
        margin-bottom: 5px;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-body h2 {
        font-weight: 700;
        font-size: 24px;
        line-height: 30px;
        color: #222222;
        margin-bottom: 15px;
        font-family: 'Poppins', sans-serif;
    }

    .extra-larg {
        font-size: 48px;
        line-height: 36px;
        font-weight: 700;
        font-family: 'Poppins', sans-serif;
    }

    .sm {
        font-style: normal;
        font-weight: 400;
        font-size: 15px;
        line-height: 21px;
        color: #222222;
        position: relative;
        top: -12px;
        padding-left: 8px;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-body p {
        font-weight: 400;
        font-size: 15px;
        color: #222222;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-body table {
        width: 100%;
        float: left;
    }

        .pricing-body table tbody tr td:last-child {
            text-align: right;
        }

        .pricing-body table tbody tr td {
            color: #000000;
            font-size: 15px;
            font-weight: 400;
            font-family: 'Poppins', sans-serif;
        }

    .price-btn button.upgrade {
        background: #E2476C;
        color: #fff;
    }

    .price-btn button.contact {
        background: #FFFFFF;
        border: 1px solid #E2476C;
        border-radius: 30px;
        color: #E2476C;
    }


    .price-btn button {
        border-radius: 30px;
        border: none;
        padding: 10px 0px;
        margin: 15px 0px;
    }

    .price-btn {
        width: 100%;
        float: left;
        text-align: center;
    }

    .purple {
        background: #72328A;
    }

    .purple-color {
        color: #72328A;
    }

    .turquois {
        background: #3FBFC7;
    }

    .turquois-color {
        color: #3FBFC7;
    }

    .salmon {
        background: #F38592;
    }

    .salmon-color {
        color: #F38592;
    }




    .light-purple {
        background-color: #8171B0;
    }


    .barrway-red {
        background-color: #E2476C;
    }

    .free-plan .pricing-custome-inner {
        background-color: #F7F4FF;
    }

    .free-plan .pricing-body table tbody tr td {
        color: #4C4C4C;
    }

    .free-plan h2, .free-plan .extra-larg {
        color: #444444;
    }

    .heder-price-empyty {
        height: 32px;
    }

    .empty-space {
        width: 100%;
        float: left;
        height: 36px;
    }
</style>

<!-- banner -->
<section class="top-banner">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="banner-form">
                    <h1>@Resource.Pricing</h1>


                </div>
            </div>

        </div>
    </div>
</section>

<section class="subcatageory">
    <div class="container">
        <div class="row Pricing-wrapper">
            <div class="content container-fluid">

                <div class="row Pricing-wrapper">
                    <div class="col-md-12" id="Pricing_Table"></div>
                </div>

            </div>

        </div>
    </div>
</section>


@section scripts{
    <script src="~/Scripts/MarketplaceScripts/Pricing.js"></script>
}
