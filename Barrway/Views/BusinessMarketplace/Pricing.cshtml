
@{
    ViewBag.Title = "Pricing";
    Layout = "~/Views/Shared/_LayoutBusinessMarketPlace.cshtml";
}

<style>

    .selected-red {
        color: #E2476C;
        font-weight: bold;
    }

    .pricing-custome-inner {
        min-height: 500px !important;
    }

    .red-color {
        color: #E2476C;
    }

    .bg-black {
        background: black;
    }

    .pricing-custome {
        width: 20%;
        float: left;
        padding: 0px 5px;
    }

    .pricing-custome-inner {
        width: 100%;
        float: left;
        border: 1px solid #CCCCCC;
        border-radius: 15px;
        margin-top: 30px;
    }

    .pricing-body {
        padding: 0px 15px;
        width: 100%;
        float: left;
    }

    .heder-price {
        border-radius: 15px 15px 0px 0px;
        width: 100%;
        float: left;
        height: 20px;
    }

    .pricing-body h3 {
        font-weight: 600;
        font-size: 18px;
        line-height: 24px;
        height: 24px;
        color: #222222;
        margin-top: 20px;
        margin-bottom: 5px;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-body h2 {
        font-weight: 700;
        font-size: 24px;
        line-height: 30px;
        color: #222222;
        margin-bottom: 15px;
        font-family: 'Poppins', sans-serif;
    }

    .extra-larg {
        font-size: 48px;
        line-height: 36px;
        font-weight: 700;
        font-family: 'Poppins', sans-serif;
    }

    .sm {
        font-style: normal;
        font-weight: 400;
        font-size: 15px;
        line-height: 21px;
        color: #222222;
        position: relative;
        top: -12px;
        padding-left: 8px;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-body p {
        font-weight: 400;
        font-size: 15px;
        color: #222222;
        font-family: 'Poppins', sans-serif;
    }

    .pricing-body table {
        width: 100%;
        float: left;
    }

        .pricing-body table tbody tr td:last-child {
            text-align: right;
        }

        .pricing-body table tbody tr td {
            color: #000000;
            font-size: 15px;
            font-weight: 400;
            font-family: 'Poppins', sans-serif;
        }

    .price-btn button.upgrade {
        background: #E2476C;
        color: #fff;
    }

    .price-btn button.contact {
        background: #FFFFFF;
        border: 1px solid #E2476C;
        border-radius: 30px;
        color: #E2476C;
    }


    .price-btn button {
        border-radius: 30px;
        border: none;
        width: 100%;
        padding: 10px 0px;
        margin: 15px 0px;
    }

    .price-btn {
        width: 100%;
        float: left;
        text-align: center;
    }

    .purple {
        background: #72328A;
    }

    .purple-color {
        color: #72328A;
    }

    .turquois {
        background: #3FBFC7;
    }

    .turquois-color {
        color: #3FBFC7;
    }

    .salmon {
        background: #F38592;
    }

    .salmon-color {
        color: #F38592;
    }

    .free-plan .pricing-custome-inner {
        background-color: #F7F4FF;
    }

    .free-plan .pricing-body table tbody tr td {
        color: #4C4C4C;
    }

    .free-plan h2, .free-plan .extra-larg {
        color: #444444;
    }

    @@media screen and (min-width:1681px) and (max-width:2560px) {
        .pricing-custome-inner {
            min-height: 50vh;
        }
    }

    @@media screen and (max-width:1680px) {
        .pricing-custome-inner {
            min-height: 75vh;
        }
    }

    @@media screen and (max-width:1440px) {
        .pricing-custome-inner {
            min-height: 75vh;
        }
    }

    @@media screen and (max-width:1366px) {
        .pricing-custome-inner {
            min-height: 91vh;
        }
    }

    @@media screen and (max-width:1280px) {
        .extra-larg {
            font-size: 35px;
        }

        .pricing-custome-inner {
            min-height: 80vh;
        }
    }

    @@media screen and (min-width:769px) and (max-width:1024px) {
        .Pricing-wrapper .pricing-custome {
            width: 50%;
        }

        .pricing-custome-inner {
            min-height: 85vh;
        }
    }

    @@media screen and (max-width:768px) {
        .Pricing-wrapper .pricing-custome {
            width: 100%;
        }

        div#navbarDoubleLineContainerNavDropdown, div#navbarContainerNavDropdown {
            background-color: #fff;
            border-top: 1px solid #ddd;
        }

        .pricing-custome-inner {
            min-height: auto;
            padding-bottom: 20px;
        }
    }
</style>

