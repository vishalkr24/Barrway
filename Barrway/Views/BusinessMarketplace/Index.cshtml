<!-- Barrway -->
<section class="Barrway mt-80">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="booking-text">
                    <h2>Barrway Market Place</h2>
                    <p>Showcasing your business on Barrway Marketplace platform offers increased visibility, access to a targeted audience, enhanced credibility, simplified marketing and customer acquisition, ready-to-use infrastructure and support, and expansion opportunities. It helps you reach more potential customers, build trust, and leverage the platform's existing marketing efforts while accessing a wider market and streamlining business operations.</p>
                    <p><a href="/MarketPlace/Index"  class="learn-more btn">Learn more</a></p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="booking-im bo-ra">
                    <img src="~/assets/img/mainhome.png">
                </div>
            </div>
        </div>
    </div>
</section>


