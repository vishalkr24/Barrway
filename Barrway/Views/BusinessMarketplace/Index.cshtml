<section class="bookinng mt-80">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="booking-text">
                    <h2>Barrway for Business: Elevating Your Service Management</h2>
                    <p class="bs-paragraph">Barrway is a leading SaaS platform that offers tailored solutions for local businesses to manage bookings, payments, and customer interactions. Whether you operate in the workshop sector, health clinic, beauty industry, hospitality, or manage a co-working space, Barrway is designed to streamline your operations and enhance customer satisfaction.</p>
                    <p style="text-align: center;"><button class="learn-more"><a href="/BusinessMarketplace/Features"> @Resource.See_our_features </a></button></p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="booking-im">
                    <img src="~/assets/marketplace/image/cal-chat.png">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HDIW -->
<section class="hdiw mt-60 mb-60">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hdiw-inner">
                    <h2>@Resource.Way_of_use</h2>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="hdiw-cont">
                                <div class="im">
                                    <img src="~/assets/img/one1.png">
                                </div>
                                <div class="txt">
                                    <h3>Class and workshop</h3>
                                    <p>eg. Yoga class, Piano class, Baking workshop</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hdiw-cont">
                                <div class="im">
                                    <img src="~/assets/img/two.png">
                                </div>
                                <div class="txt">
                                    <h3>Service appointment</h3>
                                    <p>eg. appoint booking for clinic, massage, hair cut, nail treatment</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hdiw-cont">
                                <div class="im">
                                    <img src="~/assets/img/Restaurant.png">
                                </div>
                                <div class="txt">
                                    <h3>Restaurant</h3>
                                    <p>Ticketing system and room booking for restuarant</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hdiw-cont">
                                <div class="im">
                                    <img src="~/assets/marketplace/image/counter-service-logo.png">
                                </div>
                                <div class="txt">
                                    <h3>Counter service</h3>
                                    <p>Ticketing system to any kind of counter services</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hdiw-cont">
                                <div class="im">
                                    <img src="~/assets/img/three.png">
                                </div>
                                <div class="txt">
                                    <h3>Room booking</h3>
                                    <p>eg. Party room, co-working space, dance studio, private office room booking</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="hdiw-cont">
                                <div class="im">
                                    <img src="~/assets/img/five.png">
                                </div>
                                <div class="txt">
                                    <h3>Event registration</h3>
                                    <p>eg. Volunteering event, Dinner event</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WOU 2 -->
<section class="hdiw mt-60 mb-60">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hdiw-inner new_hdiw_inner">
                    <h2>Getting Started with Barrway</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="hdiw-cont-2">
                    <div class="im">
                        <img src="~/assets/img/step-1.png">
                    </div>
                    <div class="txt">
                        <h3><span>Step 1</span> Register Your Business</h3>
                        <p>Register using your email or phone number at no cost.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="hdiw-cont-2">
                    <div class="im">
                        <img src="~/assets/img/step-2.png">
                    </div>
                    <div class="txt">
                        <h3><span>Step 2</span> Choose Your Plan</h3>
                        <p>Choose the subscription plan that fits your business size and needs.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="hdiw-cont-2">
                    <div class="im">
                        <img src="~/assets/img/step-3.png">
                    </div>
                    <div class="txt">
                        <h3><span>Step 3</span> Set Up Your Platform </h3>
                        <p>Use our setup service to quickly get your website and booking calendar up and running, or customize them on your own.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="hdiw-cont-2">
                    <div class="im">
                        <img src="~/assets/img/step-4.png">
                    </div>
                    <div class="txt">
                        <h3><span>Step 4</span> Begin Managing Bookings</h3>
                        <p>through your new online portal and manage all aspects of customer interactions effortlessly.
                        </p>
                    </div>
                </div>
            </div>
            @*<div class="col-md-12">
                <p class="bs-paragraph">Barrway is a leading SaaS platform that offers tailored solutions for local businesses to manage bookings, payments, and customer interactions. Whether you operate in the workshop sector, health clinic, beauty industry, hospitality, or manage a co-working space, Barrway is designed to streamline your operations and enhance customer satisfaction.</p>
            </div>
            <div class="col-md-12">
                <p style="text-align: center;"><button class="learn-more"><a href="javascript:void(0)">@Resource.See_our_features</a></button></p>
            </div>*@
        </div>
    </div>
</section>

