    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="banner-form">
                    <h1 class="fz_47">@Resource.Easiest_way_to_organize_your_events_and_participants_in_one_stop</h1>

                </div>
            </div>
            <div class="col-md-6">
                <div class="banner-image bmarketplace-image">
                    <img src="~/assets/img/bmarketplace.png">
                </div>
            </div>
        </div>
    </div>
</section>

