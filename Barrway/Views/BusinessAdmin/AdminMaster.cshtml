
@{
    ViewBag.Title = "Admin Master";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}

<link href="~/fg-assets/tabulator/css/tabulator_site.min.css" rel="stylesheet" />
<link href="~/fg-newAssets/css/style.css" rel="stylesheet" />
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" integrity="sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN" crossorigin="anonymous">
<main id="content" role="main" class="main">
    <div class="modal modal-lg" id="AssignDetailsModal" role="dialog">

        <style>
            .btn-assign {
                outline: none;
                border: none;
                width: 130px;
                border-radius: 4px;
                height: 41px;
                max-width: 130px !important;
                background: white;
                border: 2px solid #377dff;
                color: black;
            }

            .selector-container {
                padding: 16px 0px;
            }

            .assign-module-radio:checked + .btn-assign {
                background: #377dff;
                color: white;
            }
        </style>

        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">


                    <h2 style="font-size: calc(1.25625rem + 0.075vw)" class="modal-title"><b>Assign as Super User</b></h2>
                    <div style="font-size:32px; line-height:24px; text-align:right;">
                        <a href="javascript:void(0)" style="text-decoration:none; color:black;" onclick="$(document.getElementById('AssignDetailsModal')).modal('hide')">&times;</a>
                    </div>
                </div>

                <div class="modal-body pt-4">

                    <button type="button" id="update-permit-btn" class="btn btn-primary">Assign Company</button>

                    @*<div class="selector-container">

                            <input type="radio" name="assign-module-radio" class="assign-module-radio" checked value="Company" style="display:none;" id="assign-company-module" />
                            <label for="assign-company-module" class="">Company</label>

                            <input type="radio" name="assign-module-radio" class="assign-module-radio" value="Business" style="display:none;" id="assign-business-module" />
                            <label for="assign-business-module" class="pl-2">Business</label>

                        </div>

                        <div id="company-selector-section">
                            Select Companies to Assign
                            <div id="tom-select-container">
                                <select id="company-selector" autocomplete="off" multiple>
                                    <option value="">Select Companies...</option>
                                    <option selected value="4"></option>
                                </select>
                            </div>

                        </div>*@
                    <p class="pt-4" style="font-size: smaller;">
                        <b>Note:</b> <br />
                        &bull; Assigning other user as the Super user of the company will give that user rights to add or remove users from selected company.<br />
                        &bull; Once the user is assigned as the Super User you will become a admin of the same company.
                    </p>
                </div>

            </div>
        </div>
    </div>

    <div class="modal modal-lg" id="InvitationHistoryModal" role="dialog">

        <style>
            .btn-assign {
                outline: none;
                border: none;
                width: 130px;
                border-radius: 4px;
                height: 41px;
                max-width: 130px !important;
                background: white;
                border: 2px solid #377dff;
                color: black;
            }

            .selector-container {
                padding: 16px 0px;
            }

            .assign-module-radio:checked + .btn-assign {
                background: #377dff;
                color: white;
            }
        </style>

        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 style="font-size: calc(1.25625rem + 0.075vw)" class="modal-title"><b>Invitations Sent</b></h2>
                </div>

                <div class="modal-body">

                    <div class="row">
                        <div class="col-md-12">
                            <div class="tabulator-section">
                                <div class="form-builder-loader-2 text-center">
                                    <div class="loader">
                                        <i class="fa fa-spinner fa-pulse fa-fw"> </i>
                                        <div>
                                            Loading Form Tabulator...
                                        </div>
                                    </div>
                                </div>
                                <div id="form-records-2"></div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" onclick="$('#InvitationHistoryModal').modal('hide')" class="btn back">Close</button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal modal-m" id="InviteUserModal" role="dialog">

        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="text-align:right;">
                    <span type="button" onclick="$('#InviteUserModal').modal('hide')" style=" font-size: 50px; float: right; position: relative; line-height: 18px; left: 90%;">&times;</span>
                </div>

                <div class="modal-body" style="padding: 0px 40px;">
                    <h2 style="font-size: calc(1.25625rem + 0.075vw); padding-bottom: 16px;" class="modal-title"><b>Add User as Admin</b></h2>

                    <div class="row">
                        <div class="col-md-12">
                            <label>
                                <b>Search user by email</b>
                            </label>
                            <div class="input-holder">
                                <input id="invite-input" class="form-control" />
                                <button class="btn"><i class="fa fa-search" style="font-size: 18px;" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    </div>
                    <br /><br />
                    <div>
                        <button type="button" onclick="$('#InviteUserModal').modal('hide')" class="btn btn-default">Cancel</button>
                        <button type="button" onclick="sendInvitation()" class="btn btn-primary">Add</button>
                    </div>

                </div>
                <div class="modal-footer">

                </div>

            </div>
        </div>
    </div>

    <div class="content container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="bredcrump">
                    <span><a class="" href="javascript:void(0)">@Resource.Barrway_business</a> / <a href="javascript:void(0)">@Resource.Manage @Resource.Company @Resource.Admin</a> </span>
                </div>
            </div>
        </div>

        <style>
            .input-holder {
                border: 1px solid lightgrey;
                border-radius: 3px;
                width: calc(100%);
                float: left;
            }

                .input-holder input {
                    outline: none;
                    border: none;
                    width: calc(100% - 50px);
                    display: inline;
                }

                .input-holder select {
                    width: 250px;
                    float: left;
                    border: none;
                    border-bottom: 0px solid #e4daff;
                    /*border-right: 1px solid #8171B0;*/
                    border-radius: 0px;
                    border-bottom-right-radius: 0px;
                }

                .input-holder button {
                    outline: none;
                    border: none;
                    width: 45px;
                    border-radius: 4px;
                    height: 42px;
                    max-width: 130px !important;
                    border-top-left-radius: 0px;
                    border-bottom-left-radius: 0px;
                }

            @@media screen and (max-width: 800px) {

                .input-holder input {
                    outline: none;
                    border: none;
                    width: calc(100% - 50px);
                    display: inline;
                }

                .input-holder select {
                    width: 100%;
                    float: left;
                    border: none;
                    border-bottom: 1px solid #e4daff;
                    /*border-right: 1px solid #8171B0;*/
                    border-radius: 0px;
                    border-bottom-right-radius: 0px;
                }
            }

            .invitation-btn {
                background: white !important;
                color: black !important;
                border: 2px solid #88579a !important;
                border-radius: 4px !important;
            }
        </style>

        <div class="row mb-2">
            <div class="col-md-12 form-inner" style="max-width:100%;">
                <h2><b>@Resource.Manage @Resource.Company @Resource.Admin</b></h2>
            </div>
            <div class="col-md-12 form-inner" style="max-width:100%;">
                <div style="">


                    <div class="d-flex" style="align-items:end; justify-content:space-between;">
                        <div class="d-flex align-items-end">
                            <div>
                                <label>Group Records By:</label>
                                <select id="filter-admin-records" class="form-control" onchange="groupAdminRecords(this.value)" style="max-width: 150px;">
                                    <option value="USER_EMAIL">Email</option>
                                    <option value="USER_ID">User Id</option>
                                    <option selected value="ROLE_TYPE">Role</option>
                                </select>
                            </div>
                            <div>
                                <button style=" margin-left: 8px;" title="View Invitations" class="btn btn-primary invitation-btn" onclick="setInvitationHistoryMaster()">History</button>
                            </div>

                        </div>
                        <div>
                            <button style="margin-top:-40px;" class="btn btn-primary" onclick="openInviteModal()">Add User</button>
                        </div>


                    </div>

                </div>


            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="tabulator-section">
                    <div class="form-builder-loader text-center">
                        <div class="loader">
                            <i class="fa fa-spinner fa-pulse fa-fw"> </i>
                            <div>
                                Loading Form Tabulator...
                            </div>
                        </div>
                    </div>
                    <div id="form-records"></div>
                </div>
            </div>
        </div>

    </div>

</main>

@section scripts{
    <script src="~/Scripts/jquery.blockUI/jquery.blockUI.min.js"></script>
    <script src="/fg-assets/tabulator/js/tabulator.js"></script>
    <script src="/Scripts/BusinessScripts/AdminMaster.js"></script>
}

