
@{
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
    ViewBag.Title = "Dashboard";
}

<main id="content" role="main" class="main">
    <!-- Content -->
    <div class="content container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="bredcrump">
                    <span><a href="#">Company name</a> / <a href="#">Dashboard</a> </span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-7">
                <div class="row">
                    <div class="col-md-12">
                        <div class="startbusiness">
                            <div class="setup">
                                <span>Step 1</span><span> - Set up company profile</span><span id="CompanyProfileSetupBtn" style="float: right;" onclick="location.href = '@Url.Action("SetupBusinessProfile", "BusinessAdmin")'"><a href="#" class="purple">Go</a> </span>
                            </div>
                            <div class="setup">
                                <span>Step 2</span><span> - Set up calendar</span><span id="CalendarSetupBtn" style="float: right;" onclick="location.href = '@Url.Action("SetupBusinessCalendar", "BusinessAdmin")'"><a href="#" class="purple">Go</a> </span>
                            </div>
                            <div class="setup">
                                <span>Step 3</span><span> - Set up company webiste</span><span style="float: right;"><a href="#" class="purple">Go</a> </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="row">
                    <div class="col-md-12">
                        <div class="wraping">
                            <div class="top-head barrway-red">
                                <h3>Website visits</h3>
                                <img src="../assets/img/ques.png">
                            </div>
                            <div class="wrap-body">
                                <div class="wb-top">
                                    <p>Let’s set up your website. <a href="#" style="color: #72328A;"><u>Set up now.</u></a></p>
                                </div>
                                <div class="wb-bottom">

                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="wraping">
                            <div class="top-head barrway-red">
                                <h3>Your plans & subscription</h3>
                                <img src="../assets/img/ques.png">
                            </div>
                            <div class="wrap-body">
                                <div class="wb-top">
                                    <div class="w-l w-80">
                                        <h3>Basic Plan HK$299/month</h3>
                                    </div>
                                    <div class="w-r w-20">
                                        <h3><img src="" /></h3>
                                    </div>
                                </div>
                                <div class="wb-bottom">
                                    <div class="w-l w-80">
                                        <table>
                                            <tbody>
                                                <tr>
                                                    <td>Vaid till:</td>
                                                    <td>YYYY-MM-DD</td>
                                                </tr>
                                                <tr>
                                                    <td>Booking available</td>
                                                    <td>1,000/5,000</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="w-r w-20">
                                        <p><a href="#" class="see-plan purple"> See plans</a></p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Content -->
</main>


<script>

    $(document).ready(function(){
        getCompanyWebsite();
    });

    function getCompanyWebsite() {

        $.ajax({
            url: "/BusinessAdmin/GetBusinessAccountWebsite/",
            data: {
                UserId: "@UserIdentity.UserName"
            },
            type: "GET",
            success: function (response) {
                response = JSON.parse(response);
                console.log(response)

                if (response.CURRENT_STEP == "COMPLETED") {
                    window.location.replace("/BusinessAdmin/BusinessDashboard")
                } else {
                    if (response.COMPANY_PROFILE_STATUS == "Y") {
                        $("#CompanyProfileSetupBtn a").text("Done");
                    }

                    if (response.COMPANY_CALENDAR_STATUS == "Y") {
                        $("#CalendarSetupBtn a").text("Done");
                    }
                }
                


            },
            error: function (errorResponse) {

            }
        })

    }

</script>