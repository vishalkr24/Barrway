@using Barrway.DTO.BusinessModels
@model Barrway.DTO.BusinessModels.BusinessCompanyViewModel

@{
    ViewBag.Title = "Manage Company Website";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}

<style>
    .form-navigation .nav-link {
        color: unset;
    }

    .form-navigation .nav-tabs .nav-link.active {
        border-color: none !important;
    }

    .form-navigation .nav-link.active:after {
        background: none;
    }

    .form-inner input, .form-inner select, textarea {
        border: 1px solid #8171B0 !important;
        box-shadow: none;
    }
</style>

<div class="content container-fluid">

    <div class="row justify-content-lg-center mt-5">
        <div class="bredcrump">
            <span><a class="lbl-company-name" href="javascript:void(0)">Company name</a> / <a href="javascript:void(0)">@Resource.Manage</a> </span>
        </div>
    </div>

    <div class="js-nav-scroller hs-nav-scroller-horizontal mb-5 form-navigation" style="position:sticky; top:0px; background:white;">
        <span class="hs-nav-scroller-arrow-prev" style="display: none;">
            <a class="hs-nav-scroller-arrow-link" href="javascript:;">
                <i class="bi-chevron-left"></i>
            </a>
        </span>

        <span class="hs-nav-scroller-arrow-next" style="display: none;">
            <a class="hs-nav-scroller-arrow-link" href="javascript:;">
                <i class="bi-chevron-right"></i>
            </a>
        </span>

        <ul class="nav nav-tabs align-items-center">
            <li id="btn1" class="nav-item" onclick="renderPage('1')">
                <a class="nav-link active" href="javascript:void(0)">@Resource.Basic_Information</a>
            </li>
            <li id="btn2" class="nav-item" onclick="renderPage('2')">
                <a class="nav-link" href="javascript:void(0)">@Resource.Service</a>
            </li>
            <li id="btn3" class="nav-item" onclick="renderPage('3')">
                <a class="nav-link" href="javascript:void(0)">@Resource.Calendar_Package</a>
            </li>
            <li id="btn4" class="nav-item" onclick="renderPage('4')">
                <a class="nav-link" href="javascript:void(0)">@Resource.Photo_album</a>
            </li>
        </ul>
    </div>
    <input type="text" value="@ViewBag.PageId" id="pageCheckId" style="display:none;" readonly />
    <div class="form-inner" style="max-width:unset;">

        <div id="div1">
            @RenderPage("~/Views/BusinessAdmin/_EditCompanyInformation.cshtml", Model)
        </div>

        <div id="div2" style="display:none;">
            @RenderPage("~/Views/BusinessAdmin/_EditCompanyService.cshtml", Model)
        </div>

        <div id="div3" style="display:none;">

        </div>

        <div id="div4" style="display:none;">
            @RenderPage("~/Views/BusinessAdmin/_CompanyPhotoAlbum.cshtml", Model)
        </div>
        <br /><br />

    </div>
    <div class="modal" id="uploadPhotoModal" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Resource.Upload_Photo</h5>
                </div>

                <div class="modal-body">

                    <div class="custome-uploade">
                        @*<input type="text" id="uploadFile" class="f-input" placeholder="This photo will be seen in market place" />*@


                        <label for="photoAlbumForm_ALBUM_PHOTO_PATH" id="ALBUM_PHOTO_NAME" style="width:80%; max-width:300px; padding-left:16px;"></label>


                        <div class="fileUpload btn btn--browse">
                            <span>Browse</span>
                            @Html.TextBoxFor(model => model.photoAlbumForm.ALBUM_PHOTO_PATH, new { @class = "upload", Type = "File", @multiple = true, @onchange = "BindLogoName('photoAlbumForm_ALBUM_PHOTO_PATH', 'ALBUM_PHOTO_NAME')" })
                            @*<input id="CALENDAR_PHOTO_PATH" type="file" class="upload" />*@
                        </div>
                    </div>

                    <div class="invalid-feedback-2" id="ALBUM_PHOTO_ERROR" style="display:none!important;">
                        @Resource.Please_choose_image_files_ONLY
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" onclick="closeUploadPhotoModal()" class="btn back">@Resource.Cancel</button>
                    <button type="button" onclick="savePhotoAlbum()" class="btn btn-default">@Resource.Save</button>
                </div>

            </div>
        </div>
    </div>



</div>

@section scripts{
    <script src="~/Scripts/BusinessScripts/ManageCompanyWebsite.js"></script>
    
}

