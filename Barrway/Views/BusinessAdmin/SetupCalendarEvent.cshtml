        font-size: 18px !important;
        font-weight: 400 !important;
        text-align: left;
    }

    .hed-til p {
        color: rgba(34, 34, 34, 1) !important;
    }

    .choose {
        width: 100%;
        float: left;
    }

        .choose .chose-inner {
            width: 100%;
            float: left;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            display: flex;
            margin-bottom: 15px;
        }

            .choose .chose-inner .one {
