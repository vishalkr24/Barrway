@model Barrway.DTO.BusinessModels.BusinessCalendarViewModel

@{
    ViewBag.Title = "SetupCalendarEvent";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}


<style>
    .rectangle:hover {
        cursor: pointer;
    }

    .error-div {
        border-radius: 6px;
        background: red;
        color: white;
        padding: 20px;
        font-size: 14px;
        font-weight: bold;
    }

    .advanced-option {
        display: none;
    }
</style>

<style>
    .form-navigation .nav-link {
        color: unset;
    }

    .form-navigation .nav-tabs .nav-link.active {
        border-color: none !important;
    }

    .form-navigation .nav-link.active:after {
        background: none;
    }

    .form-inner input, .form-inner select, textarea {
        border: 1px solid #8171B0 !important;
        box-shadow: none;
    }
</style>
<style>
    #templates-row .card {
        /* Change background color */
        background-color: white;
        /* Add border */
        border: 1px solid #bacdd8;
        /* Add space between the border and the content */
        padding: 8px;
        border-radius: 12px;
    }

        #templates-row .card img {
            max-height: 200px;
        }

    /* Style div elements that have class equal to tag */
    #templates-row .tag {
        padding: 4px 8px;
        border: 1px solid #e5eaed;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        color: #788697;
    }

    /* Style div elements that have class equal to name */
    #templates-row .name {
        font-size: 24px;
        font-weight: 600;
        margin-top: 16px;
    }

    /* Style p element */
    #templates-row p {
        font-size: 14px;
        color: #7f8c9b;
        line-height: 150%;
        padding-top: 4px;
    }

    /* Style button element */
    #templates-row button {
        border: none;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        color: #0077ff;
        background-color: #e0efff;
        /* Button is inline-block element by default, it need to have block display for margin: 0 auto; to work */
        margin: 0 auto;
        display: block;
        /* Button is a clickable element, therefore it should have a pointer cursor */
        cursor: pointer;
    }

        #templates-row button.active {
            border: none;
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 600;
            color: white;
            background-color: #0077ff;
            /* Button is inline-block element by default, it need to have block display for margin: 0 auto; to work */
            margin: 0 auto;
            display: block;
            /* Button is a clickable element, therefore it should have a pointer cursor */
            cursor: pointer;
        }

    #templates-row .card__details {
        /* Add space around the details */
        padding: 16px 8px 8px 8px;
    }

    #templates-row button:focus, button:hover {
        background-color: #0077ff;
        color: #e0efff;
    }
</style>
<input type="text" value="@Model.CALENDAR_CODE" id="calendarCodeInput" style="display:none;" readonly />
<input type="text" value="@Model.COMPANY_CODE" id="companyCodeInput" style="display:none;" readonly />
<input type="text" value="@Model.CALENDAR_CATEGORY_ID" id="calendarCategoryInput" style="display:none;" readonly />

<style>
    .template-selection-area #templates-row {
        min-height: 700px;
        max-height: 700px;
        overflow: hidden;
        overflow-y: scroll;
        box-shadow: none;
        transition: all 0.2s ease-in-out;
    }

    .template-selection-area .col-md-4 {
        padding: 16px;
        border-radius: 25px;
        border: 3px solid white;
        cursor: pointer;
    }

        .template-selection-area .col-md-4.active {
            padding: 16px;
            border-radius: 25px;
            border: 3px solid #01aa005c;
            /*box-shadow: inset 0px 0px 16px #01aa005c;*/
            cursor: pointer;
        }

            .template-selection-area .col-md-4.active:hover {
                padding: 16px;
                border-radius: 25px;
                border: 3px solid #01aa005c;
                /*box-shadow: inset 0px 0px 16px #01aa005c;*/
                cursor: pointer;
            }

        .template-selection-area .col-md-4:hover {
            /*box-shadow: inset 0px 0px 16px #18366d5c;*/
            border: 3px solid #18366d5c;
            transition: all 0.2s ease-in-out;
        }

    .template-image {
        height: 160px;
        max-width: 260px;
        width: 100%;
        border-radius: 25px;
        border: none;
        /*box-shadow: 0px 4px 20px 0px #18366d5c;*/
    }

    @@media (max-width: 800px) {
        .template-selection-area #templates-row {
            min-height: 300px;
            max-height: 300px;
        }
    }

    .set-cal .form-group {
        padding: 0px 0px !important;
    }

    div#step-3 p, div#step-4 p, div#step-5 p, div#step-6 p {
        font-weight: 700;
        font-size: 24px;
        color: rgba(226, 71, 108, 1);
    }

    div#step-3 .ycaml p, div#step-4 .ycaml p {
        font-size: 15px;
        font-weight: 400;
        position: relative;
        color: #000;
        font-style: italic;
    }


    div#step-3 .ycaml button, div#step-4 .ycaml button {
        border: 1px solid rgba(129, 113, 176, 1);
        color: rgba(129, 113, 176, 1);
        background: transparent;
        width: 130px;
        vertical-align: middle;
        padding: 8px 0px;
    }

    p.sp {
        color: rgba(0, 0, 0, 1) !important;
        font-size: 18px !important;
        font-weight: 400 !important;
        text-align: left;
    }

    .hed-til p {
        color: rgba(34, 34, 34, 1) !important;
    }

    .choose {
        width: 100%;
        float: left;
    }

        .choose .chose-inner {
            width: 100%;
            float: left;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            display: flex;
            margin-bottom: 15px;
        }

            .choose .chose-inner .one {
                width: 10%;
                float: left;
                text-align: center;
            }

                .choose .chose-inner .one img {
                    width: 100%;
                }

            .choose .chose-inner .two {
                width: 80%;
                float: left;
            }

            .choose .chose-inner .three {
                width: 10%;
                float: left;
            }

            .choose .chose-inner .two p {
                color: rgba(114, 50, 138, 1) !important;
                font-size: 18px !important;
                font-weight: 600 !important;
                margin-bottom: 0px;
                display: flex;
                align-items: center;
                height: 100%;
                padding-left: 12px;
            }

            .choose .chose-inner .three p {
                display: flex;
                vertical-align: baseline;
                align-items: center;
                height: 100%;
                justify-content: center;
            }

                .choose .chose-inner .three p img {
                    width: 10px;
                }


    [type="radio"]:checked,
    [type="radio"]:not(:checked) {
        position: absolute;
        left: -9999px;
    }

        [type="radio"]:checked + label, [type="radio"]:not(:checked) + label {
            position: relative;
            padding-left: 28px;
            cursor: pointer;
            line-height: 20px;
            display: inline-block;
            color: #000;
            font-size: 15px;
            font-weight: 400;
            margin-right: 9px;
        }

            [type="radio"]:checked + label:before,
            [type="radio"]:not(:checked) + label:before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 19px;
                height: 19px;
                border: 1px solid #ddd;
                border-radius: 100%;
                background: #fff;
            }

            [type="radio"]:checked + label:after, [type="radio"]:not(:checked) + label:after {
                content: '';
                width: 15px;
                height: 15px;
                background: rgba(204, 204, 204, 1);
                position: absolute;
                top: 2px;
                left: 2px;
                border-radius: 100%;
                -webkit-transition: all 0.2s ease;
                transition: all 0.2s ease;
            }

            [type="radio"]:not(:checked) + label:after {
                opacity: 0;
                -webkit-transform: scale(0);
                transform: scale(0);
            }

            [type="radio"]:checked + label:after {
                opacity: 1;
                -webkit-transform: scale(1);
                transform: scale(1);
            }

    button.bg-t-b {
        border: 1px solid rgba(129, 113, 176, 1);
        color: rgba(129, 113, 176, 1);
        background: transparent;
        width: 130px;
        vertical-align: middle;
        padding: 8px 0px;
    }

    .schedular-table thead {
        border-bottom: 1px solid lightgrey;
    }

        .schedular-table thead tr td {
            font-weight: bold;
            text-align: center;
            padding: 8px;
        }

    .schedular-table tbody tr td:first-child {
        font-weight: bold;
        padding: 8px;
        border-right: 1px solid lightgrey;
        text-align: center;
    }

    .schedular-table tbody tr td {
        padding: 8px;
        text-align: center;
    }

        .schedular-table tbody tr td input[type=time] {
            width: 100% !important;
        }
</style>

<main id="content" role="main" class="main">

    <div class="container">
        <div id="step-3" style="display:none;" class="row pt-lg-6">

            <div class="col-md-12">
                <div class="m-width_50">
                    <div class="form-inner" style="max-width:100%;">
                        <p>Step 3 of 5</p>
                        <div class="hed-til">
                            <p>Give a name for your event location</p>
                        </div>
                        <div>

                            <div id="div1">
                                <div class="text-center">
                                    <div class="profile-form">
                                        <style>
                                            .form-inner {
                                                margin-left: 0px !important;
                                            }
                                        </style>
                                        <div style="text-align:right; color:crimson;">* mandatory</div>
                                        <div class="form-inner set-cal" style="max-width:100%;">
                                            <div id="locations-div">

                                            </div>

                                            <div class="ycaml">
                                                <p>You can add more location if your event takes place in more than one location.</p>
                                                <button class="bg-t-b" onclick="addMoreLocation()">+Add more</button>
                                            </div>

                                            <button type="button" onclick="moveToStep(2)" class="back">@Resource.Back</button>
                                            <button type="button" class="btn btn-primary" onclick="moveToStep(4)">@Resource.Next</button>


                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
                <!-- Title -->
                <!-- End Title -->
            </div>

        </div>
        <div id="step-4" style="display:none;" class="row pt-lg-6">

            <div class="col-md-5 m-auto">

                <div class="form-inner" style="max-width:100%;">
                    <p> Step 4 of 5</p>
                    <div class="hed-til">
                        <p>Service provider details</p>
                    </div>
                    <div>

                        <div id="div1">
                            <div class="text-center">
                                <div class="profile-form">
                                    <style>
                                        .form-inner {
                                            margin-left: 0px !important;
                                        }
                                    </style>

                                    <div class="form-inner set-cal" style="max-width:100%;">
                                        <div id="providers-div">

                                        </div>

                                        <div class="ycaml">
                                            <p>You can add more service providers if your event has more than one service providers.</p>
                                            <button class="bg-t-b" onclick="addMoreProvider()">+Add more</button>
                                        </div>
                                        <button type="button" onclick="moveToStep(3)" class="back">@Resource.Back</button>
                                        <button type="button" class="btn btn-primary" onclick="moveToStep(5)">@Resource.Next</button>


                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Title -->
                <!-- End Title -->
            </div>

        </div>
        <div id="step-5" style="display:none;" class="row pt-lg-6">

            <div class="col-md-5 m-auto">

                <div class="form-inner" style="max-width:100%;">
                    <p>Step 5 of 5</p>
                    <div class="hed-til">
                        <p>Which one describe your course the best?</p>
                    </div>

                    <div class="f_of_f-wrap-o">
                        <div class="choose">
                            @if (Model.CALENDAR_CATEGORY_ID == "1" || Model.CALENDAR_CATEGORY_ID == "5")
                            {
                                <input type="radio" name="calendarTypeRadio" style="display:none;" value="PACKAGE" id="calendarTypePackage" />
                                <div class="chose-inner" onclick="moveToStep(6, 'Package')">
                                    <div class="one">
                                        <img src="../assets/svg/logos/favicon.png" />
                                    </div>
                                    <div class="two">
                                        <p>Fixed number of sessions within the course</p>
                                    </div>
                                    <div class="three">
                                        <p><img src="../assets/img/purple.png" /></p>
                                    </div>
                                </div>
                            }


                            <input type="radio" name="calendarTypeRadio" style="display:none;" value="MANUAL" id="calendarTypeManual" />
                            <div class="chose-inner" onclick="moveToStep(6, 'Manual')">
                                <div class="one">
                                    <img src="../assets/svg/logos/favicon.png" />
                                </div>
                                <div class="two">
                                    <p>Customer can buy credits and freely book any session within a period of time</p>
                                </div>
                                <div class="three">
                                    <p><img src="../assets/img/purple.png" /></p>
                                </div>
                            </div>
                        </div>
                        <button type="button" onclick="backToStep(4)" class="back">@Resource.Back</button>
                    </div>

                </div>

            </div>

        </div>
        <div id="step-6" style="display:none;" class="row pt-lg-6">

            <div class="col-md-5 ">

                <div class="form-inner" style="max-width:100%;">
                    <p>Step 5 of 5</p>

                    <div class="f_of_f-wrap-t">
                        <div class="form-inner set-cal" style="max-width:100%;">
                            <div class="hed-til">
                                <p>Set up service and sessions of the course</p>
                            </div>

                            <div class="form-group">

                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="calendarname">Service Name *</label>

                                        <input type="text" class="form-control" id="serviceName" placeholder="" name="serviceName">
                                        <div class="invalid-feedback-2" id="SCH_ACTIVITY_ERROR">
                                            Please mention name of service
                                        </div>
                                    </div>
                                    @if (Model.CALENDAR_CATEGORY_ID == "1" || Model.CALENDAR_CATEGORY_ID == "5")
                                    {
                                        <div class="col-md-6">
                                            <label for="calendarname">Max. Participants *</label>

                                            <input type="number" class="form-control" id="maxParticipants" placeholder="" name="serviceName">
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group ">
                                <div class="row">
                                    <div class="col-md-6 cus-radio">
                                        <div>
                                            <label>Is Service Paid?</label>
                                        </div>

                                        <input type="radio" id="test1" name="servicePaid" value="Y" checked>
                                        <label for="test1">Yes</label>


                                        <input type="radio" id="test2" name="servicePaid" value="N">
                                        <label for="test2">No</label>
                                    </div>
                                    <div class="col-md-6" id="feesPerSessionDiv">
                                        <label for="feesPerSession">Fees per Session *</label>

                                        <input type="number" class="form-control" id="feesPerSession" placeholder="" name="feesPerSession">
                                    </div>
                                </div>

                            </div>

                            <div class="form-group">

                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="sessionLocationMaster">Location</label>
                                        <select class="form-control" id="sessionLocationMaster" placeholder="" name="sessionLocationMaster"></select>
                                        <div class="invalid-feedback-2" id="SCH_LOCATION_ERROR">
                                            Please select Location
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="sessionServiceProviderMaster">Service Provider</label>
                                        <select class="form-control" id="sessionServiceProviderMaster" placeholder="" name="sessionServiceProviderMaster"></select>
                                        <div class="invalid-feedback-2" id="SCH_RESOURCE_ERROR">
                                            Please select Service Provider
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <br />
                            <div class="form-group">

                                <div class="row">
                                    <div class="col-md-6">
                                        <label for="SCH_FROM_DATE">Start Date *</label>
                                        <input type="date" class="form-control" id="SCH_FROM_DATE" placeholder="" name="SCH_FROM_DATE">
                                        <div class="invalid-feedback-2" id="SCH_FROM_DATE_ERROR">
                                            Please select from date
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="SCH_TO_DATE">End Date *</label>
                                        <input type="date" class="form-control" id="SCH_TO_DATE" placeholder="" name="SCH_TO_DATE">
                                        <div class="invalid-feedback-2" id="SCH_TO_DATE_ERROR">
                                            Please select to date
                                        </div>
                                    </div>
                                </div>

                            </div>


                            <div class="form-group">
                                <div class="col-md-12">
                                    <input type="checkbox" name="TimeSameAsMonday" onclick="setSameTime()" /> {{translation.Time_same_as_monday}}
                                </div>

                                <div class="col-md-12">
                                    <table class="schedular-table" width="100%">
                                        <thead>
                                            <tr>
                                                <td>Day</td>
                                                <td>{{translation.Start_Time}}</td>
                                                <td>{{translation.End_Time}}</td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>MON</td>
                                                <td><input type="time" id="Monday_Start_Time" onchange="setSameDateValue()" class="form-control" /></td>
                                                <td><input type="time" id="Monday_End_Time" onchange="setSameDateValue()" class="form-control" /></td>
                                            </tr>
                                            <tr>
                                                <td>TUE</td>
                                                <td><input type="time" id="Tuesday_Start_Time" class="form-control" /></td>
                                                <td><input type="time" id="Tuesday_End_Time" class="form-control" /></td>
                                            </tr>
                                            <tr>
                                                <td>WED</td>
                                                <td><input type="time" id="Wednesday_Start_Time" class="form-control" /></td>
                                                <td><input type="time" id="Wednesday_End_Time" class="form-control" /></td>
                                            </tr>
                                            <tr>
                                                <td>THU</td>
                                                <td><input type="time" id="Thursday_Start_Time" class="form-control" /></td>
                                                <td><input type="time" id="Thursday_End_Time" class="form-control" /></td>
                                            </tr>
                                            <tr>
                                                <td>FRI</td>
                                                <td><input type="time" id="Friday_Start_Time" class="form-control" /></td>
                                                <td><input type="time" id="Friday_End_Time" class="form-control" /></td>
                                            </tr>
                                            <tr>
                                                <td>SAT</td>
                                                <td><input type="time" id="Saturday_Start_Time" class="form-control" /></td>
                                                <td><input type="time" id="Saturday_End_Time" class="form-control" /></td>
                                            </tr>

                                            <tr>
                                                <td>SUN</td>
                                                <td><input type="time" id="Sunday_Start_Time" class="form-control" /></td>
                                                <td><input type="time" id="Sunday_End_Time" class="form-control" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="" style="text-align: right;">
                                <button class="bg-t-b" style="width: 150px;">+Add more Session</button>
                            </div>

                            <button type="button" onclick="backToStep(5)" class="back">@Resource.Back</button>
                            <button type="button" class="btn btn-primary" onclick="submitCalendar()">@Resource.Save</button>


                        </div>
                    </div>


                </div>

                <!-- Title -->
                <!-- End Title -->
            </div>
            <div class="col-md-5">
                <div class="form-inner" style="max-width:100%;">
                    <div style="text-align:right; padding: 8px;">
                        Preview
                    </div>
                    <div id="preview-calendar-div">

                    </div>
                </div>
            </div>
        </div>
    </div>

</main>

@section scripts{
    <script src="~/Scripts/BusinessScripts/SetupCalendarEvent.js"></script>
}
