                <!-- End Title -->
            </div>

        </div>
        <div class="row pt-lg-6">

            <div id="step-5" class="col-md-6 m-auto">

                <div class="form-inner" style="max-width:100%;">
                    Step 5 of 5
                    <form action="/BusinessAdmin/AddCalendar?IsPartial=@ViewBag.IsPartial.ToString().ToLower()" method="post" enctype="multipart/form-data">

                        <div id="div1">
