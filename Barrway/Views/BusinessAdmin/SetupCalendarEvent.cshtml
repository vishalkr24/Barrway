@model Barrway.DTO.BusinessModels.BusinessCalendarViewModel

@{
    ViewBag.Title = "SetupCalendarEvent";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}


<style>
    .rectangle:hover {
        cursor: pointer;
    }

    .error-div {
        border-radius: 6px;
        background: red;
        color: white;
        padding: 20px;
        font-size: 14px;
        font-weight: bold;
    }

    .advanced-option {
        display: none;
    }
</style>

<style>
    .form-navigation .nav-link {
        color: unset;
    }

    .form-navigation .nav-tabs .nav-link.active {
        border-color: none !important;
    }

    .form-navigation .nav-link.active:after {
        background: none;
    }

    .form-inner input, .form-inner select, textarea {
        border: 1px solid #8171B0 !important;
        box-shadow: none;
    }
</style>
<style>
    #templates-row .card {
        /* Change background color */
        background-color: white;
        /* Add border */
        border: 1px solid #bacdd8;
        /* Add space between the border and the content */
        padding: 8px;
        border-radius: 12px;
    }

        #templates-row .card img {
            max-height: 200px;
        }

    /* Style div elements that have class equal to tag */
    #templates-row .tag {
        padding: 4px 8px;
        border: 1px solid #e5eaed;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        color: #788697;
    }

    /* Style div elements that have class equal to name */
    #templates-row .name {
        font-size: 24px;
        font-weight: 600;
        margin-top: 16px;
    }

    /* Style p element */
    #templates-row p {
        font-size: 14px;
        color: #7f8c9b;
        line-height: 150%;
        padding-top: 4px;
    }

    /* Style button element */
    #templates-row button {
        border: none;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        color: #0077ff;
        background-color: #e0efff;
        /* Button is inline-block element by default, it need to have block display for margin: 0 auto; to work */
        margin: 0 auto;
        display: block;
        /* Button is a clickable element, therefore it should have a pointer cursor */
        cursor: pointer;
    }

        #templates-row button.active {
            border: none;
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 600;
            color: white;
            background-color: #0077ff;
            /* Button is inline-block element by default, it need to have block display for margin: 0 auto; to work */
            margin: 0 auto;
            display: block;
            /* Button is a clickable element, therefore it should have a pointer cursor */
            cursor: pointer;
        }

    #templates-row .card__details {
        /* Add space around the details */
        padding: 16px 8px 8px 8px;
    }

    #templates-row button:focus, button:hover {
        background-color: #0077ff;
        color: #e0efff;
    }
</style>
<input type="text" value="@ViewBag.IsPartial.ToString().ToLower()" id="createCalendarCheck" style="display:none;" readonly />
<input type="text" value="@Model.CALENDAR_CODE" id="calendarCodeInput" style="display:none;" readonly />
<style>
    .template-selection-area #templates-row {
        min-height: 700px;
        max-height: 700px;
        overflow: hidden;
        overflow-y: scroll;
        box-shadow: none;
        transition: all 0.2s ease-in-out;
    }

    .template-selection-area .col-md-4 {
        padding: 16px;
        border-radius: 25px;
        border: 3px solid white;
        cursor: pointer;
    }

        .template-selection-area .col-md-4.active {
            padding: 16px;
            border-radius: 25px;
            border: 3px solid #01aa005c;
            /*box-shadow: inset 0px 0px 16px #01aa005c;*/
            cursor: pointer;
        }

            .template-selection-area .col-md-4.active:hover {
                padding: 16px;
                border-radius: 25px;
                border: 3px solid #01aa005c;
                /*box-shadow: inset 0px 0px 16px #01aa005c;*/
                cursor: pointer;
            }

        .template-selection-area .col-md-4:hover {
            /*box-shadow: inset 0px 0px 16px #18366d5c;*/
            border: 3px solid #18366d5c;
            transition: all 0.2s ease-in-out;
        }

    .template-image {
        height: 160px;
        max-width: 260px;
        width: 100%;
        border-radius: 25px;
        border: none;
        /*box-shadow: 0px 4px 20px 0px #18366d5c;*/
    }

    @@media (max-width: 800px) {
        .template-selection-area #templates-row {
            min-height: 300px;
            max-height: 300px;
        }
    }
</style>

<main id="content" role="main" class="main">
    
    <div class="container">
        <div class="row pt-lg-6">

            <div id="step-3" class="col-md-6 m-auto">

                <div class="form-inner" style="max-width:100%;">
                    Step 3 of 5
                    <form action="/BusinessAdmin/AddCalendar?IsPartial=@ViewBag.IsPartial.ToString().ToLower()" method="post" enctype="multipart/form-data">

                        <div id="div1">
                            <div class="text-center">
                                <div class="profile-form">
                                    <style>
                                        .form-inner {
                                            margin-left: 0px !important;
                                        }
                                    </style>

                                    <div class="form-inner" style="max-width:100%;">
                                        @Html.TextBoxFor(model => model.Id, new { @style = "display:none" })
                                        @Html.TextBoxFor(model => model.COMPANY_CODE, new { @style = "display:none" })
                                        @Html.TextBoxFor(model => model.CALENDAR_CODE, new { @style = "display:none" })
                                        @Html.TextBoxFor(model => model.CALENDAR_TEMPLATE_ID, new { @style = "display:none" })
                                        @Html.TextBoxFor(model => model.SCHEDULAR_ID, new { @style = "display:none" })

                                        <div class="form-group">
                                            <label for="calendarname">@Resource.Calendar_Name *</label>

                                            @Html.TextBoxFor(model => model.CALENDAR_NAME, new { @class = "form-control", @placeholder = "Calendar name", @required = "true" })
                                            @Html.ValidationMessageFor(model => model.CALENDAR_NAME, "", new { @class = "invalid-feedback-2" })

                                            @*<input type="text" class="form-control" id="calendarname" placeholder="" name="calendarname">*@
                                        </div>


                                        <button type="button" onclick="renderCategory()" class="back">@Resource.Back</button>
                                        @if (ViewBag.IsPartial)
                                        {
                                            <button type="submit" class="btn btn-primary">@Resource.Save</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-primary" onclick="renderPage(2)">@Resource.Next</button>
                                        }


                                    </div>
                                </div>
                            </div>
                        </div>

                    </form>

                </div>

                <!-- Title -->
                <!-- End Title -->
            </div>

        </div>
