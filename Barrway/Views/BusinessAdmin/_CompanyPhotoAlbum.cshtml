@model Barrway.DTO.BusinessModels.BusinessCompanyViewModel

<div style="text-align:right">
    @*<button type="button" onclick="renderCategory()" class="btn back">Cancel</button>*@
    <button type="button" onclick="openUploadPhotoModal()" class="btn btn-default">Upload Photo</button>
    @*<button type="submit" class="btn btn-default">Save</button>*@
</div>

<style>
    .image-container {
        position: relative;
        display: inline-block;
    }

    .delete-icon {
        position: absolute;
        top: 0px;
        right: 12px;
        font-weight: bold;
        color: white;
        background: linear-gradient(to top right, transparent, grey 106%);
        padding: 6px 12px;
        border-top-right-radius: 8px;
        cursor: pointer;
        border-bottom-left-radius: 50%;
    }

</style>

<div class="row" id="photoAlbumRow">
    @if (Model.photoAlbumList != null)
    {
        foreach (var item in Model.photoAlbumList)
        {
            <div class="col-md-4 mt-4 image-container">
                <img src="@item.ALBUM_PHOTO_PATH.Replace("~", "..")" class="photo-album" />
                <span class="delete-icon" onclick="deletePhotoAlbum(@item.Id)">&times;</span>
            </div>
        }
    }

</div>
