
@{
    ViewBag.Title = "Setup your business calendar Information";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}

<main id="content" role="main" class="main">
    <!-- Content -->
    <div class="content container">
        <div class="row justify-content-lg-center pt-lg-5">
            <div class="col-lg-9">
                <!-- Title -->
                <div class="text-center">
                    <div class="profile-form">
                        <h1>Let’s finish up with calendar information</h1>
                        <div class="form-inner">
                            <form action="/action_page.php">
                                <div class="form-group">
                                    <label for="calendarname">Calendar name *</label>
                                    <input type="text" class="form-control" id="calendarname" placeholder="" name="calendarname">
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="country">Country *</label>
                                            <select class="form-control" id="sel1">
                                                <option>China</option>
                                                <option>2</option>
                                                <option>3</option>
                                                <option>4</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="city">City *</label>
                                            <select class="form-control" id="sel1">
                                                <option>Hong Kong</option>
                                                <option>2</option>
                                                <option>3</option>
                                                <option>4</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="district">District *</label>
                                    <select class="form-control" id="sel1">
                                        <option>Select</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="companynamechinese">Company Name (Chinese)</label>
                                    <input type="text" class="form-control" id="companynamechinese" placeholder="" name="companynamechinese">
                                </div>
                                <div class="form-group">
                                    <label for="cala">Calendar category *</label>
                                    <select class="form-control" id="sel1">
                                        <option>Select</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="sub">Calendar Sub-category *</label>
                                    <select class="form-control" id="sel1">
                                        <option>Select</option>
                                        <option>2</option>
                                        <option>3</option>
                                        <option>4</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <p style="margin-bottom: 0px;"><label for="file">Calendar  photo</label></p>
                                    <div class="custome-uploade">
                                        <input id="uploadFile" class="f-input" placeholder="This photo will be seen in market place" />
                                        <div class="fileUpload btn btn--browse">
                                            <span>Browse</span>
                                            <input id="uploadBtn" type="file" class="upload" />
                                        </div>
                                    </div>
                                </div>
                                <button class="back">Back</button>
                                <button type="submit" class="btn btn-default">Save</button>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- End Title -->
            </div>
        </div>
        <!-- End Row -->
    </div>
    <!-- End Content -->
</main>

