@using Barrway.DTO.BusinessModels
@model Barrway.DTO.BusinessModels.BusinessCompanyViewModel

@using (Html.BeginForm("SaveCompanyWebsiteDetails", "BusinessAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div style="text-align:right; width:100%;">

        <button type="button" onclick="" class="btn back">@Resource.Cancel</button>
        <button type="submit" class="btn btn-primary">@Resource.Save</button>

    </div>
    <br />
    <div class="row form-group">
        <div class="col-md-4 mt-5">
            <label>@Resource.Company_Code</label>
            @Html.TextBoxFor(model => model.COMPANY_CODE, new { @class = "form-control", @placeholder = "Company Code", @readonly = "true", @required = "true" })
            @Html.ValidationMessageFor(model => model.COMPANY_CODE, "", new { @class = "invalid-feedback-2" })
            @*<input class="form-control" type="text" />*@
        </div>
        <div class="col-md-4 mt-5">
            <label>@Resource.Company_Logo</label>
            <div class="custome-uploade">
                
                @*@Html.TextBoxFor(model => model.COMPANY_LOGO_NAME, new { @class = "f-input", @required = "true", @style = "width: 75%; border:none!important;" })*@

                <label for="COMPANY_LOGO_PATH" id="COMPANY_LOGO_NAME" style="width:80%; max-width:300px; padding-left:16px;">@Model.COMPANY_LOGO_NAME</label>

                <div class="fileUpload btn btn--browse">
                    <span>Browse</span>
                    @Html.TextBoxFor(model => model.COMPANY_LOGO_PATH, new { @class = "upload", Type = "File", @onchange="BindLogoName('COMPANY_LOGO_PATH', 'COMPANY_LOGO_NAME')" })
                    
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.COMPANY_LOGO_PATH, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-4 mt-5">
            <label>@Resource.Website_banner</label>

            <div class="custome-uploade">
               
                @*@Html.TextBoxFor(model => model.COMPANY_BANNER_NAME, new { @class = "f-input", @required = "true", @style = "width: 75%; border:none!important;" })*@

                <label for="COMPANY_BANNER_PATH" id="COMPANY_BANNER_NAME" style="width:80%; max-width:300px; padding-left:16px;">@Model.COMPANY_BANNER_NAME</label>

                <div class="fileUpload btn btn--browse">
                    <span>Browse</span>
                    @Html.TextBoxFor(model => model.COMPANY_BANNER_PATH, new { @class = "upload", Type = "File", @onchange = "BindLogoName('COMPANY_BANNER_PATH', 'COMPANY_BANNER_NAME')" })
                    
                </div>

            </div>
            @Html.ValidationMessageFor(model => model.COMPANY_BANNER_PATH, "", new { @class = "invalid-feedback-2" })
            
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-6 mt-5">
            <label>@Resource.Company_Name (English)</label>
            @Html.TextBoxFor(model => model.COMPANY_NAME_ENGLISH, new { @class = "form-control", @placeholder = "Company Name English", @required = "true" })
            @Html.ValidationMessageFor(model => model.COMPANY_NAME_ENGLISH, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-6 mt-5">
            <label>@Resource.Company_Name (Chinese)</label>
            @Html.TextBoxFor(model => model.COMPANY_NAME_CHINESE, new { @class = "form-control", @placeholder = "Company Name Chinese", @required = "true" })
            @Html.ValidationMessageFor(model => model.COMPANY_NAME_CHINESE, "", new { @class = "invalid-feedback-2" })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-6 mt-5">
            <label>@Resource.Company_category</label>
            @Html.DropDownListFor(model => model.COMPANY_CATEGORY_ID, new SelectList(Enum.GetValues(typeof(CompanyCategory))), "Select Company Category", new { @class = "form-control", @required = "true" })
            @Html.ValidationMessageFor(model => model.COMPANY_CATEGORY_ID, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-6 mt-5">
            <label>@Resource.Company_sub_category</label>
            @Html.DropDownListFor(model => model.COMPANY_SUB_CATEGORY_ID, new SelectList(Enum.GetValues(typeof(CompanyCategory))), "Select Company Sub Category", new { @class = "form-control", @required = "true" })
            @Html.ValidationMessageFor(model => model.COMPANY_SUB_CATEGORY_ID, "", new { @class = "invalid-feedback-2" })
            
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-12 mt-5">
            <label>@Resource.Address</label>
            @Html.TextBoxFor(model => model.COMPANY_ADDRESS, new { @class = "form-control", @placeholder = "Company Address" })
            @Html.ValidationMessageFor(model => model.COMPANY_ADDRESS, "", new { @class = "invalid-feedback-2" })
            
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-4 mt-5">
            <label>@Resource.Country</label>
            @Html.DropDownListFor(model => model.COUNTRY_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select Country", @required = "true" })
            @Html.ValidationMessageFor(model => model.COUNTRY_ID, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-4 mt-5">
            <label>@Resource.City</label>
            @Html.DropDownListFor(model => model.CITY_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select City", @required = "true" })
            @Html.ValidationMessageFor(model => model.CITY_ID, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-4 mt-5">
            <label>@Resource.District</label>
            @Html.DropDownListFor(model => model.DISTRICT_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select District", @required = "true" })
            @Html.ValidationMessageFor(model => model.DISTRICT_ID, "", new { @class = "invalid-feedback-2" })
            
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-6 mt-5">
            <label>@Resource.Phone</label>
            @Html.TextBoxFor(model => model.COMPANY_PHONE, new { @class = "form-control", @placeholder = "Company Phone" })
            @Html.ValidationMessageFor(model => model.COMPANY_PHONE, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-6 mt-5">
            <label>@Resource.Email</label>
            @Html.TextBoxFor(model => model.COMPANY_EMAIL, new { @class = "form-control", @placeholder = "Company Email" })
            @Html.ValidationMessageFor(model => model.COMPANY_EMAIL, "", new { @class = "invalid-feedback-2" })
            
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-3 mt-5">
            <label>Facebook Url</label>
            @Html.TextBoxFor(model => model.FACEBOOK_URL, new { @class = "form-control", @placeholder = "Facebook url" })
            @Html.ValidationMessageFor(model => model.FACEBOOK_URL, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-3 mt-5">
            <label>Instagram Url</label>
            @Html.TextBoxFor(model => model.INSTAGRAM_URL, new { @class = "form-control", @placeholder = "Instagram url" })
            @Html.ValidationMessageFor(model => model.INSTAGRAM_URL, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-3 mt-5">
            <label>Wechat Url</label>
            @Html.TextBoxFor(model => model.WECHAT_URL, new { @class = "form-control", @placeholder = "Wechat url" })
            @Html.ValidationMessageFor(model => model.WECHAT_URL, "", new { @class = "invalid-feedback-2" })
            
        </div>
        <div class="col-md-3 mt-5">
            <label>Twitter Url</label>
            @Html.TextBoxFor(model => model.TWITTER_URL, new { @class = "form-control", @placeholder = "Twitter url" })
            @Html.ValidationMessageFor(model => model.TWITTER_URL, "", new { @class = "invalid-feedback-2" })
            
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-12 mt-5">
            <label>@Resource.Company_description (200 @Resource.words)</label>
            @Html.TextAreaFor(model => model.COMPANY_DESCRIPTION, new { @class = "form-control", @placeholder = "write your company description in 200 words", @style = "resize:vertical; height:120px;" })
            @Html.ValidationMessageFor(model => model.COMPANY_DESCRIPTION, "", new { @class = "invalid-feedback-2" })
            
        </div>

    </div>

    <div class="row form-group">
        <div class="col-md-12 mt-5">
            <label>@Resource.Tags</label>
            @Html.TextBoxFor(model => model.TAGS, new { @class = "form-control", @placeholder = "" })
            @Html.ValidationMessageFor(model => model.TAGS, "", new { @class = "invalid-feedback-2" })
            
        </div>

    </div>

    <div class="row form-group">

        <div class="col-md-5 mt-5">
            <label>@Resource.Searchable_in_Market_Place? (@Resource.This_profile_page_will_be_visible_by_public_if_you_choose_yes)</label>
            <div>
                @Html.RadioButtonFor(model => model.IS_SEARCHABLE_IN_MARKETPLACE, "Y", new { @selected = true }) @Resource.Yes
                @Html.RadioButtonFor(model => model.IS_SEARCHABLE_IN_MARKETPLACE, "N") @Resource.No
            </div>

        </div>

        <div class="col-md-5 mt-5">
            <label>Page url</label>
            @Html.TextBoxFor(model => model.PAGE_URL, new { @class = "form-control", @placeholder = "page url" })
            @*<input class="form-control" type="text" />*@
        </div>

        <div class="col-md-2 mt-5">
            <div style="height:24px"></div>
            <button type="button" class="btn btn-default" onclick="bindPageUrl('@Model.COMPANY_CODE')">@Resource.Public_website_link</button>
        </div>
        @Html.TextBoxFor(model => model.Id, new { @readonly = "true", @style = "visibility:hidden" })
        @Html.TextBoxFor(model => model.BUSINESS_ACCOUNT_ID, new { @readonly = "true", @style = "visibility:hidden" })
    </div>

}
<br />
<br />
<br />
<br />
