<script>

    function isUrlavailable() {
        var url = $("#PAGE_URL").val();
            $.ajax({
                url: '@Url.Action("CheckCmpanyUrlExists", "BusinessAdmin")', // Replace "ControllerName" with your actual controller name
                type: 'POST',
                dataType: 'json',
                data: { Url: url, CompanyCode: "@Model.COMPANY_CODE" },
                success: function(response) {
                    if (response.Status == false) {

                        $("#basic").append('<br/><p style="color: red;" id="UrlValidationmessage"> This page url already exist !</p>');
                    } else {

                        $("#UrlValidationmessage").remove();
                    }
                },
                error: function(xhr, status, error) {
                    $("#UrlValidationmessage").empty();
                }
            });
    }

</script>

<script>
    var mapDiv = 'MarkerMap_1712646834218';
    var mapLatLng = 'MarkerMap_1712646834218';
    var mapLatitude = '22.302711';
    var mapLongitude = '114.177216';
    var Latitude="@Model.Latitude";
    var Longitude ="@Model.Longitude";  
    if (Latitude == "" || Longitude == "") {
        initGMap(mapDiv, mapLatitude, mapLongitude);
    }
    else {
        initGMap(mapDiv, Latitude, Longitude);
    }



    function initGMap(mapDiv, mapLatitude, mapLongitude) {

        var latitude = parseFloat(mapLatitude);
        var longitude = parseFloat(mapLongitude);
        var latLng = { lat: latitude, lng: longitude };

        // Create map
        var map = new google.maps.Map(document.getElementById(mapDiv), {
            zoom: 15,
            center: latLng,
            mapTypeControl: true, // Show map type control
            mapTypeId: google.maps.MapTypeId.ROADMAP, // Default to roadmap view
            zoomControl: true, // Show zoom control
            scaleControl: true, // Show scale control
            streetViewControl: true // Show street view control
        });

        // Create marker
        var marker = new google.maps.Marker({
            position: latLng,
            map: map,
            draggable: true // Make marker draggable
        });

        // Add event listener for marker dragend event
        google.maps.event.addListener(marker, 'dragend', function (event) {
            var newLat = event.latLng.lat();
            var newLng = event.latLng.lng();
            $('#Latitude').val(newLat);
            $('#Longitude').val(newLng);

        });
    }




</script>








