@using Barrway.DTO.BusinessModels
@model Barrway.DTO.BusinessModels.BusinessCalendarViewModel
@{
    ViewBag.Title = "Setup your business calendar";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}

<style>
    .rectangle:hover {
        cursor: pointer;
    }

    .error-div {
        border-radius: 6px;
        background: red;
        color: white;
        padding: 20px;
        font-size: 14px;
        font-weight: bold;
    }

    .advanced-option {
        display: none;
    }
</style>
@if (!ViewBag.IsPartial)
{
    <div class="main" id="error-div" style="display:none;">
        <div class="content container">
            <div class="row pt-lg-5">
                <div class="col-md-10" style="margin:auto;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="error-div">
                                @Resource.Kindly_complete_the_Step_1___Setup_your_company_profile <a href="/BusinessAdmin/SetupCompanyProfile" style="padding-left: 8px;">@Resource.Click_here_to_setup_now</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.UNIVERSAL_ERROR))
{
    <div class="main" id="error-div">
        <div class="content container">
            <div class="row pt-lg-5">
                <div class="col-md-10" style="margin:auto;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="error-div">
                                @Model.UNIVERSAL_ERROR<br />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="tom-select-custom" style="display:none;">
    <select class="js-select form-select" multiple autocomplete="off"></select>
</div>

<main id="content" role="main" class="main" style="display:none;">
    <!-- Content -->
    <div class="content container">
        <div class="row pt-lg-1 d-flex justify-content-center">

            @if (ViewBag.IsPartial)
            {
                <div class="col-md-12">
                    <h1>@Resource.Choose_category_for_new_calendar</h1>
                </div>
                <div class="col-md-12">
                    <br />
                </div>
            }

            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(1)">
                            <div class="rac-img">
                                <img src="../assets/img/one1.png">
                            </div>
                            <div class="rac-text">
                                <h2>@Resource.Class_and_workshop</h2>
                                <p>@Resource.eg__Yoga_class__Piano_class__Baking_workshop</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(2)">
                            <div class="rac-img">
                                <img src="../assets/img/two.png">
                            </div>
                            <div class="rac-text">
                                <h2>@Resource.Service_appointment</h2>
                                <p>@Resource.eg__doctor__massage__hair_cut__nail_treatment</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(3)">
                            <div class="rac-img">
                                <img src="../assets/img/three.png">
                            </div>
                            <div class="rac-text">
                                <h2>@Resource.Room_rental</h2>
                                <p>@Resource.eg__Party_room__co_working_space__dance_studio</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(4)">
                            <div class="rac-img">
                                <img src="../assets/img/four.png">
                            </div>
                            <div class="rac-text">
                                <h2>@Resource.Private_office_room_booking</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(5)">
                            <div class="rac-img">
                                <img src="../assets/img/five.png">
                            </div>
                            <div class="rac-text">
                                <h2>@Resource.Event_registration</h2>
                                <p>@Resource.eg__Volunteering_event__Dinner_event</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- End Row -->
    </div>
    <!-- End Content -->
</main>


<style>
    .form-navigation .nav-link {
        color: unset;
    }

    .form-navigation .nav-tabs .nav-link.active {
        border-color: none !important;
    }

    .form-navigation .nav-link.active:after {
        background: none;
    }

    .form-inner input, .form-inner select, textarea {
        border: 1px solid #8171B0 !important;
        box-shadow: none;
    }
</style>
<style>
    #templates-row .card {
        /* Change background color */
        background-color: white;
        /* Add border */
        border: 1px solid #bacdd8;
        /* Add space between the border and the content */
        padding: 8px;
        border-radius: 12px;
    }

        #templates-row .card img {
            max-height: 200px;
        }

    /* Style div elements that have class equal to tag */
    #templates-row .tag {
        padding: 4px 8px;
        border: 1px solid #e5eaed;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        color: #788697;
    }

    /* Style div elements that have class equal to name */
    #templates-row .name {
        font-size: 24px;
        font-weight: 600;
        margin-top: 16px;
    }

    /* Style p element */
    #templates-row p {
        font-size: 14px;
        color: #7f8c9b;
        line-height: 150%;
        padding-top: 4px;
    }

    /* Style button element */
    #templates-row button {
        border: none;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        color: #0077ff;
        background-color: #e0efff;
        /* Button is inline-block element by default, it need to have block display for margin: 0 auto; to work */
        margin: 0 auto;
        display: block;
        /* Button is a clickable element, therefore it should have a pointer cursor */
        cursor: pointer;
    }

        #templates-row button.active {
            border: none;
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 600;
            color: white;
            background-color: #0077ff;
            /* Button is inline-block element by default, it need to have block display for margin: 0 auto; to work */
            margin: 0 auto;
            display: block;
            /* Button is a clickable element, therefore it should have a pointer cursor */
            cursor: pointer;
        }

    #templates-row .card__details {
        /* Add space around the details */
        padding: 16px 8px 8px 8px;
    }

    #templates-row button:focus, button:hover {
        background-color: #0077ff;
        color: #e0efff;
    }
</style>
<input type="text" value="@ViewBag.IsPartial.ToString().ToLower()" id="createCalendarCheck" style="display:none;" readonly />
<input type="text" value="@Model.CALENDAR_CODE" id="calendarCodeInput" style="display:none;" readonly />
<style>
    .template-selection-area #templates-row {
        min-height: 700px;
        max-height: 700px;
        overflow: hidden;
        overflow-y: scroll;
        box-shadow: none;
        transition: all 0.2s ease-in-out;
    }

    .template-selection-area .col-md-4 {
        padding: 16px;
        border-radius: 25px;
        border: 3px solid white;
        cursor: pointer;
    }

        .template-selection-area .col-md-4.active {
            padding: 16px;
            border-radius: 25px;
            border: 3px solid #01aa005c;
            /*box-shadow: inset 0px 0px 16px #01aa005c;*/
            cursor: pointer;
        }

            .template-selection-area .col-md-4.active:hover {
                padding: 16px;
                border-radius: 25px;
                border: 3px solid #01aa005c;
                /*box-shadow: inset 0px 0px 16px #01aa005c;*/
                cursor: pointer;
            }

        .template-selection-area .col-md-4:hover {
            /*box-shadow: inset 0px 0px 16px #18366d5c;*/
            border: 3px solid #18366d5c;
            transition: all 0.2s ease-in-out;
        }

    .template-image {
        height: 160px;
        max-width: 260px;
        width: 100%;
        border-radius: 25px;
        border: none;
        /*box-shadow: 0px 4px 20px 0px #18366d5c;*/
    }

    @@media (max-width: 800px) {
        .template-selection-area #templates-row {
            min-height: 300px;
            max-height: 300px;
        }
    }
</style>

<div class="modal" id="SchedularModal" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Available Schedular</h4>
                <button type="button" onclick="closeSchedularModal()" class="btn btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="form-group">
                    <label>Select a Schedular</label>
                    <select id="schedular-selector" class="form-control" onchange="bindSchedularId()"></select>
                </div>


            </div>
        </div>
    </div>
</div>

