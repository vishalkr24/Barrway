@using Barrway.DTO.BusinessModels
@model Barrway.DTO.BusinessModels.BusinessCalendarViewModel
@{
    ViewBag.Title = "Setup your business calendar";
    Layout = "~/Views/Shared/_BusinessAdminLayout.cshtml";
}

<style>
    .rectangle:hover {
        cursor: pointer;
    }

    .error-div {
        border-radius: 6px;
        background: red;
        color: white;
        padding: 20px;
        font-size: 14px;
        font-weight: bold;
    }

    .advanced-option {
        display: none;
    }
</style>
@if (!ViewBag.IsPartial)
{
    <div class="main" id="error-div" style="display:none;">
        <div class="content container">
            <div class="row pt-lg-5">
                <div class="col-md-10" style="margin:auto;">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="error-div">
                                Kindly complete the Step 1 - Setup your company profile <a href="/BusinessAdmin/SetupCompanyProfile" style="padding-left: 8px;">Click here to setup now</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

<div class="tom-select-custom" style="display:none;">
    <select class="js-select form-select" multiple autocomplete="off"></select>
</div>

<main id="content" role="main" class="main" style="display:none;">
    <!-- Content -->
    <div class="content container">
        <div class="row pt-lg-1 d-flex justify-content-center">

            @if (ViewBag.IsPartial)
            {
                <div class="col-md-12">
                    <h1>Choose category for new calendar</h1>

                </div>
                <div class="col-md-12">
                    <br />
                </div>

            }

            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(1)">
                            <div class="rac-img">
                                <img src="../assets/img/one1.png">
                            </div>
                            <div class="rac-text">
                                <h2>Class and workshop</h2>
                                <p>eg. Yoga class, Piano class, Baking workshop</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(2)">
                            <div class="rac-img">
                                <img src="../assets/img/two.png">
                            </div>
                            <div class="rac-text">
                                <h2>Service appointment</h2>
                                <p>eg. doctor, massage, hair cut, nail treatment</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(3)">
                            <div class="rac-img">
                                <img src="../assets/img/three.png">
                            </div>
                            <div class="rac-text">
                                <h2>Room rental</h2>
                                <p>eg. Party room, co-working space, dance studio</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(4)">
                            <div class="rac-img">
                                <img src="../assets/img/four.png">
                            </div>
                            <div class="rac-text">
                                <h2>Private office room booking</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rectangle" onclick="renderForm(5)">
                            <div class="rac-img">
                                <img src="../assets/img/five.png">
                            </div>
                            <div class="rac-text">
                                <h2>Event registration</h2>
                                <p>eg. Volunteering event, Dinner event</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- End Row -->
    </div>
    <!-- End Content -->
</main>


<style>
    .form-navigation .nav-link {
        color: unset;
    }

    .form-navigation .nav-tabs .nav-link.active {
        border-color: none !important;
    }

    .form-navigation .nav-link.active:after {
        background: none;
    }

    .form-inner input, .form-inner select, textarea {
        border: 1px solid #8171B0 !important;
        box-shadow: none;
    }
</style>

<input type="text" value="@ViewBag.IsPartial.ToString().ToLower()" id="createCalendarCheck" style="display:none;" readonly />
<input type="text" value="@Model.CALENDAR_CODE" id="calendarCodeInput" style="display:none;" readonly />

<main id="content-2" role="main" class="main" style="display:none;">
    <!-- Content -->
    <div class="container">
        <div class="row justify-content-lg-center pt-lg-5">
            <div class="col-lg-12">

                <div class="js-nav-scroller hs-nav-scroller-horizontal mb-5 form-navigation" style="position:sticky; top:0px; background:white;">
                    <span class="hs-nav-scroller-arrow-prev" style="display: none;">
                        <a class="hs-nav-scroller-arrow-link" href="javascript:;">
                            <i class="bi-chevron-left"></i>
                        </a>
                    </span>

                    <span class="hs-nav-scroller-arrow-next" style="display: none;">
                        <a class="hs-nav-scroller-arrow-link" href="javascript:;">
                            <i class="bi-chevron-right"></i>
                        </a>
                    </span>

                    <ul class="nav nav-tabs align-items-center">
                        <li id="btn1" class="nav-item" onclick="renderPage('1')">
                            <a class="nav-link active" href="#">Calendar Information</a>
                        </li>
                        <li id="btn2" class="nav-item">
                            <a class="nav-link" href="#">Calendar Settings</a>
                        </li>

                    </ul>
                </div>

                <div class="form-inner" style="max-width:unset;">

                    <form action="/BusinessAdmin/AddCalendar?IsPartial=@ViewBag.IsPartial.ToString().ToLower()" method="post" enctype="multipart/form-data">


                        <div id="div1">
                            <div class="text-center">
                                <div class="profile-form">
                                    <style>
                                        .form-inner {
                                            margin-left: 0px !important;
                                        }
                                    </style>

                                    <div class="form-inner">
                                        @Html.TextBoxFor(model => model.Id, new { @style = "display:none" })
                                        @Html.TextBoxFor(model => model.COMPANY_CODE, new { @style = "display:none" })
                                        @Html.TextBoxFor(model => model.CALENDAR_CODE, new { @style = "display:none" })
                                        <div class="form-group">
                                            <label for="calendarname">Calendar name *</label>

                                            @Html.TextBoxFor(model => model.CALENDAR_NAME, new { @class = "form-control", @placeholder = "Calendar name", @required = "true" })
                                            @Html.ValidationMessageFor(model => model.CALENDAR_NAME, "", new { @class = "invalid-feedback-2" })

                                            @*<input type="text" class="form-control" id="calendarname" placeholder="" name="calendarname">*@
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="country">Country *</label>

                                                    @Html.DropDownListFor(model => model.COUNTRY_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select Country", @required = "true" })
                                                    @Html.ValidationMessageFor(model => model.COUNTRY_ID, "", new { @class = "invalid-feedback-2" })


                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="city">City *</label>

                                                    @Html.DropDownListFor(model => model.CITY_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select City", @required = "true" })
                                                    @Html.ValidationMessageFor(model => model.CITY_ID, "", new { @class = "invalid-feedback-2" })


                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="district">District *</label>

                                            @Html.DropDownListFor(model => model.DISTRICT_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select District", @required = "true" })
                                            @Html.ValidationMessageFor(model => model.DISTRICT_ID, "", new { @class = "invalid-feedback-2" })


                                        </div>

                                        <div class="form-group">
                                            <label for="cala">Calendar category *</label>

                                            @Html.DropDownListFor(model => model.CALENDAR_CATEGORY_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @onchange = "checkSlot()", @placeholder = "Select Calendar Category", @required = "true" })
                                            @Html.ValidationMessageFor(model => model.CALENDAR_CATEGORY_ID, "", new { @class = "invalid-feedback-2" })


                                        </div>
                                        <div class="form-group">
                                            <label for="sub">Calendar Sub-category *</label>

                                            @Html.DropDownListFor(model => model.CALENDAR_SUB_CATEGORY_ID, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "form-control", @placeholder = "Select Calendar Sub Category", @required = "true" })
                                            @Html.ValidationMessageFor(model => model.CALENDAR_SUB_CATEGORY_ID, "", new { @class = "invalid-feedback-2" })


                                        </div>
                                        <div class="form-group" id="duration-entry-field">
                                            <label for="calendarname">Slot Duration in Mins*</label>

                                            @Html.TextBoxFor(model => model.SLOT_DURATION_IN_MINS, new { @type = "number", @class = "form-control", @placeholder = "eg.: 15" })
                                            @Html.ValidationMessageFor(model => model.SLOT_DURATION_IN_MINS, "", new { @class = "invalid-feedback-2" })

                                            @*<input type="text" class="form-control" id="calendarname" placeholder="" name="calendarname">*@
                                        </div>
                                        <div class="form-group">
                                            <label for="TAGS">Tags</label>
                                            <div class="tom-select-custom">
                                                @Html.DropDownListFor(model => model.TAGS, new SelectList(Enum.GetValues(typeof(DropdownDefault))), new { @class = "js-select form-select", @multiple = "true", @autocomplete = "off" })
                                            </div>

                                            @Html.ValidationMessageFor(model => model.TAGS, "", new { @class = "invalid-feedback-2" })

                                        </div>
                                        <div class="form-group">
                                            <p style="margin-bottom: 0px;"><label for="file">Calendar  photo</label></p>
                                            <div class="custome-uploade">

                                                <label for="CALENDAR_PHOTO_PATH" id="CALENDAR_PHOTO_NAME" style="width:80%; max-width:300px; padding-left:16px;">This photo will be seen in market place</label>

                                                <div class="fileUpload btn btn--browse">
                                                    <span>Browse</span>
                                                    @Html.TextBoxFor(model => model.CALENDAR_PHOTO_PATH, new { @class = "upload", Type = "File", @onchange = "BindLogoName('CALENDAR_PHOTO_PATH', 'CALENDAR_PHOTO_NAME')" })

                                                </div>
                                            </div>

                                            @Html.ValidationMessageFor(model => model.CALENDAR_PHOTO_NAME, "", new { @class = "invalid-feedback-2" })

                                        </div>
                                        <button type="button" onclick="renderCategory()" class="back">Back</button>
                                        @if (ViewBag.IsPartial)
                                        {


                                            <button type="submit" class="btn btn-default">Save</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-default" onclick="renderPage(2)">Next</button>
                                        }


                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="div2" style="display:none;">
                            <div class="text-center">
                                <div class="profile-form">
                                    <style>
                                        .form-inner {
                                            margin-left: 0px !important;
                                        }
                                    </style>

                                    <div class="form-inner">

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="TAGS">Calendar display time</label>
                                                    <div class="tom-select-custom">
                                                        <div class="row">
                                                            <div class="col-lg-6">
                                                                @Html.TextBoxFor(model => model.CalendarControlSheet.DISPLAY_START_TIME, new { @class = "form-control", @type = "time", @placeholder = "Start Time" })
                                                            </div>
                                                            <div class="col-lg-6">
                                                                @Html.TextBoxFor(model => model.CalendarControlSheet.DISPLAY_END_TIME, new { @class = "form-control", @type = "time", @placeholder = "End Time" })
                                                            </div>
                                                        </div>
                                                                                                                 
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="TAGS">Privacy</label>
                                                    <div class="tom-select-custom">
                                                        @Html.DropDownListFor(model => model.CalendarControlSheet.CALENDAR_USE_TYPE, new SelectList(Enum.GetValues(typeof(PublicPrivateOptions))), new { @class = "js-select form-select" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        

                                        <div class="row" style="border-bottom:1px solid lightgrey; padding-top: 16px;">
                                            <div class="col-md-2" style="padding-top:25px;">
                                                <h3>Calendar </h3>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Form description</label>
                                                    <div class="tom-select-custom">
                                                        @Html.TextBoxFor(model => model.CalendarControlSheet.CALENDAR_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Format</label>
                                                    <div class="tom-select-custom">
                                                        @Html.DropDownListFor(model => model.CalendarControlSheet.CALENDAR_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="advanced-option">
                                            <div class="row" style="border-bottom:1px solid lightgrey; padding-top: 16px;">
                                                <div class="col-md-2" style="padding-top:25px;">
                                                    <h3>Resources </h3>
                                                </div>
                                                <div class="col-md-5">
                                                    <div class="form-group">
                                                        <label for="TAGS">Form name</label>
                                                        <div class="tom-select-custom">
                                                            @Html.TextBoxFor(model => model.CalendarControlSheet.RESOURCE_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-5">
                                                    <div class="form-group">
                                                        <label for="TAGS">Format</label>
                                                        <div class="tom-select-custom">
                                                            @Html.DropDownListFor(model => model.CalendarControlSheet.RESOURCE_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row" style="border-bottom:1px solid lightgrey; padding-top: 16px;">
                                                <div class="col-md-2" style="padding-top:25px;">
                                                    <h3>Activities </h3>
                                                </div>
                                                <div class="col-md-5">
                                                    <div class="form-group">
                                                        <label for="TAGS">Form name</label>
                                                        <div class="tom-select-custom">
                                                            @Html.TextBoxFor(model => model.CalendarControlSheet.ACTIVITY_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-5">
                                                    <div class="form-group">
                                                        <label for="TAGS">Format</label>
                                                        <div class="tom-select-custom">
                                                            @Html.DropDownListFor(model => model.CalendarControlSheet.ACTIVITY_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>


                                        <div class="row" style="border-bottom:1px solid lightgrey; padding-top: 16px;">
                                            <div class="col-md-2" style="padding-top:25px;">
                                                <h3>Location </h3>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Form name</label>
                                                    <div class="tom-select-custom">
                                                        @Html.TextBoxFor(model => model.CalendarControlSheet.LOCATION_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Format</label>
                                                    <div class="tom-select-custom">
                                                        @Html.DropDownListFor(model => model.CalendarControlSheet.LOCATION_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="row" style="border-bottom:1px solid lightgrey; padding-top: 16px;">
                                            <div class="col-md-2" style="padding-top:25px;">
                                                <h3>Registration </h3>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Form name</label>
                                                    <div class="tom-select-custom">
                                                        @Html.TextBoxFor(model => model.CalendarControlSheet.REGISTRATION_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Format</label>
                                                    <div class="tom-select-custom">
                                                        @Html.DropDownListFor(model => model.CalendarControlSheet.REGISTRATION_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="row" style="border-bottom:1px solid lightgrey; padding-top: 16px;">
                                            <div class="col-md-2" style="padding-top:25px;">
                                                <h3>Participant </h3>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Form name</label>
                                                    <div class="tom-select-custom">
                                                        @Html.TextBoxFor(model => model.CalendarControlSheet.PARTICIPANT_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Format</label>
                                                    <div class="tom-select-custom">
                                                        @Html.DropDownListFor(model => model.CalendarControlSheet.PARTICIPANT_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <div class="row" style=" padding-top: 16px;">
                                            <div class="col-md-2" style="padding-top:25px;">
                                                <h3>Evaluation </h3>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Form description</label>
                                                    <div class="tom-select-custom">
                                                        @Html.TextBoxFor(model => model.CalendarControlSheet.EVALUATION_FORM_NAME, new { @class = "form-control", @placeholder = "calendar" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <label for="TAGS">Format</label>
                                                    <div class="tom-select-custom">
                                                        @Html.DropDownListFor(model => model.CalendarControlSheet.EVALUATION_FORM_CATEGORY, new SelectList(Enum.GetValues(typeof(CalendarFormatOptions))), new { @class = "js-select form-select" })
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <button type="button" onclick="renderPage(1)" class="back">Back</button>
                                        @if (ViewBag.IsPartial)
                                        {

                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-default">Save &amp; Exit</button>
                                        }

                                    </div>


                                </div>
                            </div>
                        </div>

                    </form>

                </div>

                <!-- Title -->
                <!-- End Title -->
            </div>
        </div>
        <!-- End Row -->
    </div>
    <!-- End Content -->
</main>

@section scripts{
    <script src="~/Scripts/BusinessScripts/SetupCompanyCalendar.js"></script>
}

