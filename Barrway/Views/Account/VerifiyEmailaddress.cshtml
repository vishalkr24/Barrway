

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <title>Barrway Email varification</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link href="~/assets/css/custom-styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>

        .hide-on-small {
            display: inline-block;
        }

        .hide-on-large {
            display: none;
        }

        @@media screen and (max-width: 560px) {
            .hide-on-large {
                display: inline-block;
            }

            .hide-on-small {
                display: none;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            widtH: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', sans-serif;
        }

        body, input, textarea, button, .h1, .h2, .h3, .h4, .h5, .h6, h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
        }

        .form-group, label {
            margin-bottom: 0px;
        }

        .center {
            widtH: 100%;
            padding: 20px;
            max-width: 90%;
            margin: 0 auto;
        }

        .signUp {
            display: flex;
            widtH: 100%;
            background: mintcream;
            transition: 0.5s ease-in-out;
            border-radius: 5px;
            box-shadow: 0px 1px 10px rgba(0, 0, 0, 0.35);
        }

            .signUp.close {
                transform: translate(-25%, 0);
            }

            .signUp .left, .signUp .right {
                width: 50%;
                padding: 80px 60px;
            }

        @@media (max-width: 640px) {
            .signUp .left, .signUp .right {
                width: 100%;
            }
        }

        .signUp .left {
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
            border-top-right-radius: 5px;
            border-bottom-right-radius: 5px;
            text-align: center;
            background-image: url("../assets/img/logback.png");
            background-repeat: none;
            background-size: cover;
            background-position: center;
            color: white;
            transform-origin: center right;
            position: relative;
            transform-style: preserve-3d;
            perspective: 1000px;
            overflow: hidden;
        }
            /*.signUp .left .back {
          position: absolute;
          top: -50%;
          left: -50%;
          width: 200%;
          height: 200%;
          background-image: url("../assets/img/logback.png");
          background-repeat: none;
          background-size: cover;
          background-position: center;
          transform: rotateY(180);
          z-index: -1;
        }*/
            .signUp .left.close {
                transform: rotateY(-180deg);
                transition: 1s ease-in-out;
            }

                .signUp .left.close .back {
                    transform: rotateY(0);
                    transition: 1s ease-in-out;
                }

        .signUp .right {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            flex-direction: column;
            width: 100%;
        }

            .signUp .right form {
                width: 100%;
                float: left;
            }

            .signUp .right input[type=text],
            .signUp .right input[type=email],
            .signUp .right input[type=password] {
                width: 100%;
                display: block;
                margin: 10px 0;
                padding: 10px 10px;
                outline: none;
                border: 1px solid #3FBFC7;
                box-shadow: none;
            }

                .signUp .right input[type=text].first,
                .signUp .right input[type=email].first,
                .signUp .right input[type=password].first {
                    margin-top: 0;
                }

            .signUp .right input[type=submit] {
                padding: 10px 40px;
                border: 2px solid #008c9e;
                background: white;
                color: #008c9e;
                transition: 0.15s ease-in-out;
                border-radius: 5px;
                outline: none;
            }

                .signUp .right input[type=submit]:hover {
                    background: #008c9e;
                    color: white;
                }

            .signUp .right .input-bordered {
                width: 100%;
                position: relative;
            }

                .signUp .right .input-bordered.active label {
                    top: 0;
                    left: 0;
                    transform: translate(0, -50%) scale(0.75);
                    color: #008c9e;
                }

                .signUp .right .input-bordered.active:after {
                    width: 100%;
                }

                .signUp .right .input-bordered:after {
                    content: "";
                    display: block;
                    width: 0;
                    height: 1px;
                    background: #008c9e;
                    position: absolute;
                    bottom: 0;
                    transition: 0.15s ease-in-out;
                }

                .signUp .right .input-bordered label {
                    color: #444;
                    font-size: 15px;
                    position: absolute;
                    top: 50%;
                    left: 0;
                    transform: translate(0, -50%);
                    transition: 0.15s ease-in-out;
                    cursor: text;
                    transform-origin: center left;
                }

        .logo img {
            width: 260px;
        }

        .logo {
            width: 100%;
            text-align: center;
            margin-bottom: 30px;
        }

        .register h3 {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        label.container-label {
            display: block;
            position: relative;
            cursor: pointer;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

            label.container-label input {
                position: absolute;
                opacity: 0;
                cursor: pointer;
                height: 0;
                width: 0;
            }

        .checkmark {
            position: absolute;
            top: 0;
            left: 0;
            height: 15px;
            width: 15px;
            background-color: #3FBFC7;
        }
        /* On mouse-over, add a grey background color */
        .container-label:hover input ~ .checkmark {
            background-color: #ccc;
        }

        /* When the checkbox is checked, add a blue background */
        .container-label input:checked ~ .checkmark {
            background-color: #2196F3;
        }

        /* Create the checkmark/indicator (hidden when not checked) */
        .checkmark:after {
            content: "";
            position: absolute;
            display: none;
        }

        /* Show the checkmark when checked */
        .container-label input:checked ~ .checkmark:after {
            display: block;
        }

        /* Style the checkmark/indicator */
        .container-label .checkmark:after {
            left: 6px;
            top: 2px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 3px 3px 0;
            -webkit-transform: rotate(45deg);
            -ms-transform: rotate(45deg);
            transform: rotate(45deg);
        }

        .btn-default {
            color: #fff;
            background-color: #3fbfc7;
            border-color: #3fbfc7;
            width: 100%;
            border-radius: 40px;
            padding: 12px 0px;
            margin: 10px 0px;
        }

            .btn-default:hover, .btn-default.focus, .btn-default:focus, .btn.active.focus, .btn.active:focus, .btn.focus, .btn:active.focus, .btn:active:focus, .btn:focus {
                color: #fff;
                background-color: #3fbfc7;
                border-color: #3fbfc7;
                width: 100%;
                border-radius: 40px;
                padding: 12px 0px;
                outline: none;
            }

        .btnhome {
            color: #fff;
            background-color: #3fbfc7;
            border-color: #3fbfc7;
            width: 100%;
            border-radius: 40px;
            padding: 12px 0px;
            margin: 10px 0px;
        }

            .btnhome:hover {
                color: #fff;
                background-color: #3fbfc7;
                border-color: #3fbfc7;
                width: 100%;
                border-radius: 40px;
                padding: 12px 0px;
                margin: 10px 0px;
            }




        .logo .business-label {
            border-left: 1px solid #777777;
            position: relative;
            top: 3px;
            font-size: 20px;
            color: #777777;
            padding-left: 8px;
            margin-left: 8px;
        }

        @@media screen and (max-width:768px) {

            .logo .business-label {
                border-left: 0px solid #777777;
                position: relative;
                top: 3px;
                font-size: 20px;
                color: #777777;
                padding-left: 0px;
                margin-left: 0px;
            }

            .logo img {
                width: 100% !important;
            }

            body {
                widtH: 100%;
                min-height: auto;
                display: block;
            }

            .center {
                float: left;
                width: 100%;
                padding: 20px;
                max-width: 100%;
                margin: 0 auto;
            }
        }
    </style>


</head>

<body class="d-flex align-items-center min-h-100" style="background: linear-gradient(to right, #e2476c, #3fbfc7);">

    <section class="login">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class='center'>
                        <div class='signUp'>
                            <div class='right'>
                                <div class="logo">
                                    <img style="width: 260px;" src="../assets/img/logo.png"> <span class="business-label">Business</span>
                                </div>
                                <div class="card-wrap">
                                    <div class="custome-card">

                                        @if (TempData["failed"] != null)
                                        {
                                            <p class="text-danger">@TempData["failed"].ToString()</p>

                                        }
                                        @if (TempData["success"] != null)
                                        {
                                            <p style="color:green;">@TempData["success"].ToString()</p>
                                            <a class="btn btnhome btn-default" href="/UserAdmin#/userdashboard">Home</a>


                                        }


                                    </div>

                                </div>

                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <link href="~/fg-assets/select2/select2.css" rel="stylesheet" />
    <script src="~/fg-assets/select2/select2.js"></script>

</body>

</html>



