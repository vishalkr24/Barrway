    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js" integrity="sha512-AA1Bzp5Q0K1KanKKmvN/4d3IRKVlv9PYgwFPvm32nPO6QS8yH1HO7LbgB1pgiOxPtfeg5zEn2ba64MUcqJx6CA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <link href="~/assets/intl-tel-input/css/intlTelInput.css" rel="stylesheet" />
    <script src="~/assets/intl-tel-input/js/intlTelInput-jquery.min.js"></script>
    <script src="~/assets/intl-tel-input/js/intlTelInput.js"></script>
    @*<script>

            $(document).ready(function () {
                $("#Country_Code").select2();
            })

        </script>*@

    @if (Model != null && !string.IsNullOrEmpty(Model.Country_Origin_Code))
    {
        <script>
            var initialCountry = "@Model.Country_Origin_Code.ToLower()";
        </script>

    }
    else
    {

        <script>
            var initialCountry = "auto";
        </script>
    }

    <script>

        $(document).ready(function () {

           @*<script src="~/assets/intl-tel-input/js/utils.js"></script>*@
            const input = document.querySelector("#USER_PHONE");
            //const errorMsg = document.querySelector("#error-msg");
            //const validMsg = document.querySelector("#valid-msg");
            // here, the index maps to the error code returned from getValidationError - see readme
            const errorMap = ["Invalid number", "Invalid country code", "Too short", "Too long", "Invalid number"];

            var country;
            // initialise plugin
            let options = {
                nationalMode: false,
                separateDialCode: false,
                initialCountry: initialCountry,
                geoIpLookup: function (callback) {
                    $.get('https://ipinfo.io', function () { }, "jsonp").always(function (resp) {
                        var countryCode = (resp && resp.country) ? resp.country : "";
                        var dialCode = getDialCodeByIso2(countryCode);
                        $('#Country_Origin_Code').val(countryCode);
                        $("#Country_Code").val(dialCode);
                        callback(countryCode);
                    });
                },
                utilsScript: "/assets/intl-tel-input/js/utils.js",
                preferredCountries: ['hk', 'cn'],

                //initialCountry: "us",
                //utilsScript: "/assets/intl-tel-input/js/utils.js?1708969428263"
            };


            const iti = window.intlTelInput(input, options);

            $(input).on("countrychange", function () {
                var country = iti.getSelectedCountryData();
                $("#Country_Code").val(country.dialCode);
                $('#Country_Origin_Code').val(country.iso2);
            });

            
            function getDialCodeByIso2(iso2) {
                const countryData = window.intlTelInputGlobals.getCountryData();
                var country = countryData.find(country => country.iso2.toLowerCase() === iso2.toLowerCase());
                return country ? country.dialCode : null;
            }

            $("#USER_PHONE").change(function () {
                setContryCodeValue();
                $('.iti__globe').hide();

            });


            function setContryCodeValue() {
                var instance = $("[name=USER_PHONE]")
                instance.intlTelInput();
                var countrycode = instance.intlTelInput('getSelectedCountryData').dialCode;
                if (countrycode != undefined) {
                    $("#Country_Code").val(countrycode);
                }

            }





        })




       
    </script>


    @if(Model!=null && !string.IsNullOrEmpty(Model.USER_PHONE)) { 
    <script>
        setTimeout(function () {  $('#USER_PHONE').val('@Model.USER_PHONE'); }, 1000);
    </script>
}
</body>

</html>
