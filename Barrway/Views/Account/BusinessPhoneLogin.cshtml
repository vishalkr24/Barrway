    <section class="login">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class='center'>
                        <div class='signUp'>
                            <div class='right'>
                                <div class="logo">
                                    <a href="@Url.Action("Index","MarketPlace")"><img style="width: 260px;" src="../assets/img/logo.png"></a>
                                </div>
                                <div style="width: 100%;">
                                    <div class="tabs">
                                        <a class="tab" href="/Account/BusinessLogin">Email</a>
                                        <a class="tab active" href="#">Phone</a>
                                    </div>
                                </div>
                                <div class="register">
                                    <h3>@Resource.Login </h3>

                                    <form class="js-validate needs-validation" method="post" autocomplete="off" action="/Account/BusinessPhoneLogin?returnUrl=@Model.ReturnUrl" novalidate>
                                        @if (@TempData["MobileVerificationSuccessMessage"] != null)
                                        {
                                            <div class="alert" role="alert" style="color: #00c9a7;">
                                                @TempData["MobileVerificationSuccessMessage"]
                                            </div>
                                        }

                                        @Html.AntiForgeryToken()

                                        @Html.ValidationMessageFor(model => model.ERROR_MESSAGE, "", new { @class = "invalid-feedback-2", @autocomplete = "new-password" })

                                        <div class="form-group">

                                            <label for="Phone">@Resource.Phone</label>
                                            <div class="">

                                                @Html.HiddenFor(model => model.Country_Code)
                                                @Html.HiddenFor(model => model.Country_Origin_Code)

                                                <input type="text" name="USER_PHONE" id="USER_PHONE" placeholder="Phone" class="form-control" data-val="true" data-val-required="Please enter phone number !" value="" autocomplete="new-password" required />

                                                @*@Html.TextBoxFor(model => model.USER_PHONE, new { @class = "form-control", @placeholder = "Phone", @required = "true", @autocomplete = "nope" })*@
                                                @Html.ValidationMessageFor(model => model.USER_PHONE, "", new { @class = "invalid-feedback-2" })
                                            </div>
                                        </div>



                                        <div class="form-group">
                                            <label for="pwd">@Resource.Password</label>
                                            @*<input type="password" class="form-control" id="USER_PASSWORD" name="USER_PASSWORD" required placeholder="********">*@
                                            @Html.PasswordFor(model => model.USER_PASSWORD, new { @class = "form-control", @placeholder = "********", @required = "true", @autocomplete = "new-password" })
                                            @Html.ValidationMessageFor(model => model.USER_PASSWORD, "", new { @class = "invalid-feedback-2" })
                                        </div>

                                        <div class="checkbox">
                                            <label class="container-label">
                                                @Resource.Remember_me
                                                @Html.CheckBoxFor(model => model.REMEMBER_ME)
                                                @*<input type="checkbox" name="TERMS_ACCEPTED" id="TERMS_ACCEPTED">*@
                                                <span class="checkmark"></span>

                                                @Html.ValidationMessageFor(model => model.REMEMBER_ME, "", new { @class = "invalid-feedback-2" })
                                            </label>
                                        </div>

                                        <div class="register-btn">
                                            <button type="submit" class="btn btn-default">@Resource.Login</button>
                                        </div>
                                    </form>
                                    <div class="login_with">
                                        @using (Html.BeginForm("ExternalSignIn", "Account", new { ReturnUrl = Model.ReturnUrl, userType = "1" }))
