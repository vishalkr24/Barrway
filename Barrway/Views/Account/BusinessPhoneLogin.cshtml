                                        <div class="seperator-container text-center">
                                            <div class="seperator">
                                                or
                                            </div>
                                        </div>
                                    </div>

                                    <div class="register-btn text-center">
                                        @Resource.Don_t_have_an_account? <a href="/Account/BusinessSignup">@Resource.Register</a>
                                    </div>


                                </div>
                            </div>
                            <div class='left'>
                                <div class='back'><h1>@Resource.Find_your_service__activity___book_it_in_one_stop</h1></div>
                            </div>

                        </div>
                    </div>
