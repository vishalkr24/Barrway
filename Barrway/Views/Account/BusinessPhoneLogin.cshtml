        .signUp {
            display: flex;
            widtH: 100%;
            background: mintcream;
            transition: 0.5s ease-in-out;
            border-radius: 5px;
            box-shadow: 0px 1px 10px rgba(0, 0, 0, 0.35);
        }

            .signUp.close {
                transform: translate(-25%, 0);
            }

            .signUp .left, .signUp .right {
                width: 50%;
                padding: 80px 60px;
            }

        @@media (max-width: 640px) {
            .signUp .left, .signUp .right {
                width: 100%;
