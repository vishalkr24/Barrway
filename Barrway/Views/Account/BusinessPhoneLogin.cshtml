        }

        .signUp .left {
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2;
            border-top-right-radius: 5px;
            border-bottom-right-radius: 5px;
            text-align: center;
            background-image: url("../assets/img/logback.png");
            background-repeat: none;
            background-size: cover;
            background-position: center;
            color: white;
            transform-origin: center right;
            position: relative;
            transform-style: preserve-3d;
            perspective: 1000px;
            overflow: hidden;
        }
            /*.signUp .left .back {
          position: absolute;
          top: -50%;
          left: -50%;
          width: 200%;
          height: 200%;
          background-image: url("../assets/img/logback.png");
          background-repeat: none;
          background-size: cover;
          background-position: center;
          transform: rotateY(180);
          z-index: -1;
        }*/
            .signUp .left.close {
                transform: rotateY(-180deg);
                transition: 1s ease-in-out;
            }

                .signUp .left.close .back {
                    transform: rotateY(0);
                    transition: 1s ease-in-out;
                }

        .signUp .right {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            flex-direction: column;
        }

            .signUp .right form {
                width: 100%;
                float: left;
            }

            .signUp .right input[type=text],
            .signUp .right input[type=email],
            .signUp .right input[type=password] {
                width: 100%;
                display: block;
                margin: 10px 0;
                padding: 10px 10px;
                outline: none;
                border: 1px solid #3FBFC7;
                box-shadow: none;
            }

                .signUp .right input[type=text].first,
                .signUp .right input[type=email].first,
                .signUp .right input[type=password].first {
                    margin-top: 0;
                }

            .signUp .right input[type=submit] {
                padding: 10px 40px;
                border: 2px solid #008c9e;
                background: white;
                color: #008c9e;
                transition: 0.15s ease-in-out;
                border-radius: 5px;
                outline: none;
            }

                .signUp .right input[type=submit]:hover {
                    background: #008c9e;
                    color: white;
                }

            .signUp .right .input-bordered {
                width: 100%;
                position: relative;
            }

                .signUp .right .input-bordered.active label {
                    top: 0;
                    left: 0;
                    transform: translate(0, -50%) scale(0.75);
                    color: #008c9e;
                }

                .signUp .right .input-bordered.active:after {
                    width: 100%;
                }

                .signUp .right .input-bordered:after {
                    content: "";
                    display: block;
                    width: 0;
                    height: 1px;
                    background: #008c9e;
                    position: absolute;
                    bottom: 0;
                    transition: 0.15s ease-in-out;
                }

                .signUp .right .input-bordered label {
                    color: #444;
                    font-size: 15px;
                    position: absolute;
                    top: 50%;
                    left: 0;
                    transform: translate(0, -50%);
                    transition: 0.15s ease-in-out;
                    cursor: text;
                    transform-origin: center left;
                }

        .logo img {
            width: 260px;
        }

        .logo {
            width: 100%;
            text-align: center;
            margin-bottom: 30px;
        }

        .register h3 {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        label.container-label {
            display: block;
            position: relative;
            cursor: pointer;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

            label.container-label input {
                position: absolute;
                opacity: 0;
                cursor: pointer;
                height: 0;
                width: 0;
            }

        .checkmark {
            position: absolute;
            top: 0;
            left: 0;
            height: 15px;
            width: 15px;
            background-color: #3FBFC7;
        }
        /* On mouse-over, add a grey background color */
        .container-label:hover input ~ .checkmark {
            background-color: #ccc;
        }

        /* When the checkbox is checked, add a blue background */
        .container-label input:checked ~ .checkmark {
            background-color: #2196F3;
        }

        /* Create the checkmark/indicator (hidden when not checked) */
        .checkmark:after {
            content: "";
            position: absolute;
            display: none;
        }

        /* Show the checkmark when checked */
        .container-label input:checked ~ .checkmark:after {
            display: block;
        }

        /* Style the checkmark/indicator */
        .container-label .checkmark:after {
            left: 6px;
            top: 2px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 3px 3px 0;
            -webkit-transform: rotate(45deg);
            -ms-transform: rotate(45deg);
            transform: rotate(45deg);
        }

        .btn-default {
            color: #fff;
            background-color: #3fbfc7;
            border-color: #3fbfc7;
            width: 100%;
            border-radius: 40px;
            padding: 12px 0px;
            margin: 10px 0px;
        }

            .btn-default:hover, .btn-default.focus, .btn-default:focus, .btn.active.focus, .btn.active:focus, .btn.focus, .btn:active.focus, .btn:active:focus, .btn:focus {
